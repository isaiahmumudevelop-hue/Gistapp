<script src="/socket.io/socket.io.js"></script>
<script>
/* STATE */
let token = localStorage.getItem('token');
let me = null, socket = null, currentChat = null, chatsCache = [], messagesCache = [];
let onlineIds = new Set();
let typingTimer = null, pollTimer = null;
let lastSend = { body:'', t:0 };
let replyTo = null;
let currentFilter = 'all';
const COLORS = ['#5b8def','#7f5be0','#f6a5c0','#c86dd7','#43cea2','#f7b733','#fc4a67','#a18cd1','#ff9966','#2fbf71','#84fab0','#8fd3f4'];

/* HELPERS */
async function api(path, opts={}) {
  const headers = { 'Content-Type':'application/json', ...(opts.headers||{}) };
  if (token) headers.Authorization = 'Bearer ' + token;
  const res = await fetch(path, { ...opts, headers });
  const data = await res.json().catch(()=>({}));
  if (!res.ok) throw new Error(data.error || 'Request failed');
  return data;
}
const esc = s => String(s ?? '').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const initials = n => (n||'?').split(/\s+/).map(w=>w[0]).join('').slice(0,2).toUpperCase();
function colorFor(n){let h=0;for(const c of (n||'?'))h=(h*31+c.charCodeAt(0))>>>0;return COLORS[h%COLORS.length];}
function timeAgo(t){if(!t)return'';const d=new Date(t),diff=(Date.now()-d)/1000;if(diff<60)return'now';if(diff<3600)return Math.floor(diff/60)+'m';if(diff<86400)return Math.floor(diff/3600)+'h';if(diff<604800)return Math.floor(diff/86400)+'d';return d.toLocaleDateString();}
function timeShort(t){return new Date(t||Date.now()).toLocaleTimeString([],{hour:'numeric',minute:'2-digit'});}
function linkify(s){return esc(s).replace(/(https?:\/\/[^\s<]+)/g,'<a href="$1" target="_blank" style="color:#7b8cff">$1</a>');}
function show(id){document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active','behind'));const t=document.getElementById(id);t.classList.add('active');if(id!=='screen-list'&&id!=='screen-auth')document.getElementById('screen-list').classList.add('behind');}
function scrollBottom(){requestAnimationFrame(()=>{const b=document.getElementById('dm-body');b.scrollTop=b.scrollHeight;});}
function openModal(id){document.getElementById(id).classList.add('show');}
function closeModal(id){document.getElementById(id).classList.remove('show');}

/* AUTH */
let signupMode=false;
const authTitle=document.getElementById('auth-title'),authSub=document.getElementById('auth-sub'),
      authName=document.getElementById('auth-name'),authBtn=document.getElementById('auth-btn'),
      authSwapText=document.getElementById('auth-swap-text'),authSwapLink=document.getElementById('auth-swap-link'),
      authErr=document.getElementById('auth-err');
authSwapLink.onclick=()=>{signupMode=!signupMode;authTitle.textContent=signupMode?'Create account':'Welcome back';authSub.textContent=signupMode?'Chat by email — no phone number needed.':'Log in with your email.';authName.style.display=signupMode?'block':'none';authBtn.textContent=signupMode?'Sign up':'Log in';authSwapText.textContent=signupMode?'Already have an account?':"Don't have an account?";authSwapLink.textContent=signupMode?'Log in':'Sign up';authErr.textContent='';};
authBtn.onclick = async () => {
  authErr.textContent = '';
  const email = document.getElementById('auth-email').value.trim();
  const password = document.getElementById('auth-pass').value;
  const display_name = authName.value.trim();
  if (!email || !password) { authErr.textContent = 'Email and password required.'; return; }
  try {
    const isSignup = signupMode;
    const path = isSignup ? '/api/signup' : '/api/login';
    const body = isSignup ? { email, password, display_name } : { email, password };
    const data = await api(path, { method:'POST', body: JSON.stringify(body) });
    if (isSignup || data.needsVerification) {
      showVerifyScreen(email, data.emailSent, data.emailError);
      return;
    }
    token = data.token; localStorage.setItem('token', token); me = data.user;
    if (me && me.onboarded === false){ showOnboarding(); return; }
    await enterApp();
  } catch(e){
    if (e.message && e.message.toLowerCase().includes('verify')) {
      showVerifyScreen(document.getElementById('auth-email').value.trim());
      return;
    }
    authErr.textContent = e.message;
  }
};
document.getElementById('auth-pass').addEventListener('keydown',e=>{if(e.key==='Enter')authBtn.click();});
async function boot(){if(!token){show('screen-auth');return;}try{me=await api('/api/me');await enterApp();}catch{localStorage.removeItem('token');token=null;show('screen-auth');}}
function logout(){localStorage.removeItem('token');token=null;me=null;if(socket)socket.disconnect();if(pollTimer)clearInterval(pollTimer);location.reload();}

/* DARK + FONT */
function applyDark(on){document.body.classList.toggle('dark',!!on);}
function applyFontSize(px){document.documentElement.style.setProperty('--fs',px+'px');}
function toggleDark(){const t=document.getElementById('dark-toggle');t.classList.toggle('on');applyDark(t.classList.contains('on'));}

/* ENTER */
async function enterApp(){
  userPrefs = me.prefs || {};
  applyDark(!!me.dark_mode);
  if (me.font_size) applyFontSize(me.font_size);
  show('screen-list');
  connectSocket();
  await Promise.all([loadChats(), loadRequests()]);
  if(pollTimer) clearInterval(pollTimer);
  pollTimer=setInterval(()=>{if(!document.hidden){loadChats();loadRequests();}},8000);
  renderFilters();
}

/* SOCKET */
function connectSocket(){
  if(socket) socket.disconnect();
  socket=io({auth:{token}});
  socket.on('presence-list',ids=>{onlineIds=new Set(ids.map(Number));renderChats();renderStories();updateHeaderStatus();});
  socket.on('presence',({userId,online})=>{if(online)onlineIds.add(Number(userId));else onlineIds.delete(Number(userId));renderChats();renderStories();updateHeaderStatus();});
  socket.on('message',m=>{
    loadChats();
    if(!currentChat||Number(currentChat.id)!==Number(m.chat_id))return;
    if(Number(m.sender_id)===Number(me.id))return;
    appendBubble(m,true);
    messagesCache.push(m);
    api('/api/chats/'+currentChat.id+'/read',{method:'POST'}).catch(()=>{});
  });
  socket.on('message-edited',({id,body})=>{
    const b=document.querySelector('.bubble[data-id="'+id+'"]');
    if(!b)return;
    const t=b.querySelector('.t'); const tx=t?t.outerHTML:'';
    b.innerHTML=linkify(body)+' <i style="opacity:.55;font-size:11px">(edited)</i>'+tx;
    renderReacts(b,JSON.parse(b.dataset.reactions||'{}'));
    const m=messagesCache.find(x=>x.id===id); if(m)m.body=body;
  });
  socket.on('message-deleted',({id})=>{
    const b=document.querySelector('.bubble[data-id="'+id+'"]');
    if(b){b.classList.add('deleted');b.innerHTML='<i>This message was deleted</i>';b.dataset.reactions='{}';}
  });
  socket.on('message-pinned',({id,pinned})=>{
    const b=document.querySelector('.bubble[data-id="'+id+'"]');
    if(b)b.classList.toggle('pinned',pinned);
  });
  socket.on('reaction',({id,reactions})=>{
    const b=document.querySelector('.bubble[data-id="'+id+'"]');
    if(b){b.dataset.reactions=JSON.stringify(reactions);renderReacts(b,reactions);}
  });
  socket.on('read',()=>{});
  socket.on('typing',({userId,typing})=>{
    if(!currentChat||userId===me.id)return;
    const el=document.getElementById('dm-typing');
    if(typing){
      document.getElementById('dm-typing-av').textContent=initials(currentChat.other_name||currentChat.name||'?');
      document.getElementById('dm-typing-av').style.background=currentChat.other_color||colorFor(currentChat.other_name);
      document.getElementById('dm-typing-name').textContent=(currentChat.other_name||currentChat.name||'Someone').split(' ')[0];
      el.classList.add('show');scrollBottom();
    } else el.classList.remove('show');
  });
  socket.on('call:incoming', (payload)=>{ incomingCallScreen(payload); });
  socket.on('call:initiated', ()=>{ startOutgoingMedia().then(sendOffer); });
  socket.on('call:accepted', async ()=>{ stopRingtone(); if (pc && currentCall && currentCall.outgoing){ await sendOffer(); } });
  socket.on('call:rejected', ()=>{ setCallStatus('Call declined'); setTimeout(cleanupCall, 900); });
  socket.on('call:ended', ()=>{ setCallStatus('Call ended'); setTimeout(cleanupCall, 700); });
  socket.on('call:signal', (payload)=>{ handleCallSignal(payload.payload); });
  socket.on('requests-changed',()=>loadRequests());
  socket.on('chats-changed',()=>{loadChats();loadRequests();});
}

/* LOAD LISTS */
async function loadChats(){try{chatsCache=await api('/api/chats');renderChats();renderStories();}catch(e){console.error(e);}}
async function loadRequests(){
  try{
    const reqs=await api('/api/requests');
    const box=document.getElementById('requests');
    if(!reqs.length){box.innerHTML='';return;}
    box.innerHTML=reqs.map(r=>`
      <div class="req-card">
        ${avatarHTML(r.avatar_url, r.display_name||r.name||'G', r.avatar_color)}
        <div class="info"><b>${esc(r.display_name||r.name||'Group')}</b><small>${esc(r.email||r.type||'')} wants to ${r.type==='group'?'add you to a group':'chat'}</small></div>
        <div class="acts">
          <button class="decline" onclick="declineReq(${r.chat_id})">Decline</button>
          <button class="accept" onclick="acceptReq(${r.chat_id})">Accept</button>
        </div>
      </div>`).join('');
  }catch(e){console.error(e);}
}
async function acceptReq(id){try{await api('/api/requests/'+id+'/accept',{method:'POST'});await loadChats();await loadRequests();}catch(e){alert(e.message);}}
async function declineReq(id){try{await api('/api/requests/'+id+'/decline',{method:'POST'});await loadRequests();}catch(e){alert(e.message);}}

function displayName(c){if(c.type==='group')return c.name||('Group #'+c.id);return c.other_name||c.name||('Chat #'+c.id);}

/* FILTERS */
function renderFilters(){
  const defs=[['all','All'],['unread','Unread'],['groups','Groups'],['favorites','Favorites'],['archived','Archived']];
  const el=document.getElementById('filters');
  el.innerHTML=defs.map(([k,label])=>`<button class="chip ${currentFilter===k?'on':''}" onclick="setFilter('${k}')">${label}</button>`).join('');
}
function setFilter(f){currentFilter=f;renderFilters();renderChats();}

function filteredChats(){
  const q=document.getElementById('search').value.trim().toLowerCase();
  return chatsCache.filter(c=>{
    if(currentFilter==='unread' && !Number(c.unread||0)) return false;
    if(currentFilter==='groups' && c.type!=='group') return false;
    if(currentFilter==='favorites' && !c.favorite) return false;
    if(currentFilter==='archived' ? !c.archived : c.archived) return false;
    if(q && !displayName(c).toLowerCase().includes(q)) return false;
    return true;
  });
}

function renderChats(){
  const box=document.getElementById('chat-scroll');
  const list=filteredChats();
  if(!list.length){box.innerHTML='<div class="empty">No chats here.<br>Tap <b>New Chat</b> to start.</div>';return;}
  box.innerHTML=list.map(c=>{
    const name=displayName(c);
    const pending=c.other_status==='pending';
    const isGroup=c.type==='group';
    const color=c.other_color||colorFor(name);
    const isOnline=c.other_id&&onlineIds.has(Number(c.other_id));
    const unread=Number(c.unread||0);
    const dot=isOnline&&!isGroup?'<span class="dot"></span>':'';
    const badge=unread>0?`<span class="unread">${unread}</span>`:'';
    const icons=(c.muted?'<span class="mini-icon">🔕</span>':'')+(c.favorite?'<span class="mini-icon">⭐</span>':'')+(c.archived?'<span class="mini-icon">📦</span>':'');
    const tag=pending?' <span class="waiting-tag">Waiting</span>':(isGroup?` <span class="group-tag">${c.member_count||''}</span>`:'');
    const preview=c.last_message||(pending?'Request sent':'Tap to send a message');
    return `<div class="chat-item" data-id="${c.id}">
      <div class="ava-wrap">${avatarHTML(c.other_url, name, color)}${dot}</div>
      <div class="chat-meta"><div class="name">${esc(name)}${tag} ${icons}</div><div class="preview">${esc(preview)}</div></div>
      <div class="chat-side"><time>${timeAgo(c.last_at)}</time>${badge}</div>
    </div>`;
  }).join('');
  box.querySelectorAll('.chat-item').forEach(el=>{
    el.onclick=()=>openChat(Number(el.dataset.id));
    el.oncontextmenu=e=>{e.preventDefault();openChatActions(Number(el.dataset.id),e.clientX,e.clientY);};
    let pressTimer;
    el.addEventListener('touchstart',()=>{pressTimer=setTimeout(()=>openChatActions(Number(el.dataset.id),window.innerWidth/2,window.innerHeight/2),550);});
    el.addEventListener('touchend',()=>clearTimeout(pressTimer));
    el.addEventListener('touchmove',()=>clearTimeout(pressTimer));
  });
}

function renderStories(){
  const wrap=document.getElementById('stories');
  const recent=chatsCache.slice(0,8);
  wrap.innerHTML=`<div class="story add" onclick="openNewChat()"><div class="ring"><div>+</div></div><span>Add</span></div>`+
    recent.map(c=>{
      const name=displayName(c);
      const color=c.other_color||colorFor(name);
      const isOnline=c.other_id&&onlineIds.has(Number(c.other_id));
      return `<div class="story" data-id="${c.id}">
        <div class="ring" style="background:${isOnline?'var(--grad-1)':'linear-gradient(135deg,#d8d3ea,#efeaf7)'}"><div style="background:${color}">${esc(initials(name))}</div></div>
        <span>${esc((name||'').split(' ')[0])}</span>
      </div>`;
    }).join('');
  wrap.querySelectorAll('.story[data-id]').forEach(el=>el.onclick=()=>openChat(Number(el.dataset.id)));
}
document.getElementById('search').addEventListener('input',renderChats);

/* CHAT ACTIONS */
function openChatActions(chatId,x,y){
  const c=chatsCache.find(c=>Number(c.id)===chatId); if(!c)return;
  const menu=document.getElementById('popmenu');
  menu.innerHTML=`
    <button onclick="toggleFavorite(${chatId});closePop()">⭐ ${c.favorite?'Unfavorite':'Favorite'}</button>
    <button onclick="toggleMute(${chatId});closePop()">🔕 ${c.muted?'Unmute':'Mute'}</button>
    <button onclick="toggleArchive(${chatId});closePop()">📦 ${c.archived?'Unarchive':'Archive'}</button>
    <button onclick="deleteChat(${chatId});closePop()">🗑 Delete chat</button>
  `;
  menu.style.left=Math.min(x,window.innerWidth-220)+'px';
  menu.style.top=Math.min(y,window.innerHeight-260)+'px';
  menu.classList.add('show');
}
function closePop(){document.getElementById('popmenu').classList.remove('show');}
async function toggleFavorite(id){const c=chatsCache.find(x=>Number(x.id)===id);await api('/api/chats/'+id,{method:'PATCH',body:JSON.stringify({favorite:!c.favorite})});loadChats();}
async function toggleMute(id){const c=chatsCache.find(x=>Number(x.id)===id);await api('/api/chats/'+id,{method:'PATCH',body:JSON.stringify({muted:!c.muted})});loadChats();}
async function toggleArchive(id){const c=chatsCache.find(x=>Number(x.id)===id);await api('/api/chats/'+id,{method:'PATCH',body:JSON.stringify({archived:!c.archived})});loadChats();}
async function deleteChat(id){if(!confirm('Delete this chat from your list?'))return;await api('/api/chats/'+id,{method:'DELETE'});loadChats();}

/* OPEN CHAT */
async function openChat(id){
  const summary=chatsCache.find(c=>Number(c.id)===id);
  if(!summary)return;
  currentChat=summary;
  const name=displayName(summary);
  const color=summary.other_color||colorFor(name);
  document.getElementById('dm-name').textContent=name;
  // disappearing indicator — uses user's pref (global) for now
  var _disp = userPrefs.disappearing || 'Off';
  var _ind = document.getElementById('disappear-indicator');
  var _lbl = document.getElementById('disappear-label');
  if (_ind){
    if (_disp && _disp !== 'Off'){
      _ind.style.display = 'inline-flex';
      if (_lbl) _lbl.textContent = _disp === '24 hours' ? '24h' : (_disp === '7 days' ? '7d' : '90d');
    } else {
      _ind.style.display = 'none';
    }
  }
  const av=document.getElementById('dm-avatar');
  if (summary.other_url){
    av.textContent='';
    av.style.background = 'url(' + summary.other_url + ') center/cover';
  } else {
    av.textContent=initials(name);
    av.style.background=color;
  }
  const pending=summary.other_status==='pending';
  document.getElementById('dm-form').style.display=pending?'none':'flex';
  document.getElementById('waiting-bar').style.display=pending?'block':'none';
  updateHeaderStatus();
  show('screen-dm');
  const msgs=document.getElementById('dm-messages');
  msgs.innerHTML='<div class="empty" style="color:#5f5b80">Loading…</div>';
  try{
    const rows=await api('/api/chats/'+id+'/messages');
    messagesCache=rows;
    msgs.innerHTML='';
    rows.forEach(m=>appendBubble(m,Number(m.sender_id)!==Number(me.id)));
    scrollBottom();
    if(socket)socket.emit('join',id);
    if(summary.unread){summary.unread=0;renderChats();}
    api('/api/chats/'+id+'/read',{method:'POST'}).catch(()=>{});
  }catch(e){msgs.innerHTML=`<div class="empty">${esc(e.message)}</div>`;}
}
function updateHeaderStatus(){
  if(!currentChat)return;
  const el=document.getElementById('dm-status');
  if(currentChat.other_status==='pending'){el.innerHTML='⏳ Waiting for them to accept…';return;}
  if(currentChat.type==='group'){el.textContent=(currentChat.member_count||'')+' members';return;}
  const isOnline=currentChat.other_id&&onlineIds.has(Number(currentChat.other_id));
  el.innerHTML=`<span style="width:7px;height:7px;border-radius:50%;background:${isOnline?'#4ade80':'#c9c5dd'};display:inline-block"></span> ${isOnline?'Online':'Offline'}`;
}
function renderReacts(bubble,reactions){
  const old=bubble.querySelector('.reacts');if(old)old.remove();
  const entries=Object.entries(reactions||{}).filter(([,arr])=>Array.isArray(arr)&&arr.length);
  if(!entries.length)return;
  const div=document.createElement('div');div.className='reacts';
  div.innerHTML=entries.map(([e,arr])=>`<span>${e} ${arr.length>1?arr.length:''}</span>`).join('');
  bubble.appendChild(div);
}
function appendBubble(m,incoming){
  const msgs=document.getElementById('dm-messages');
  if(m.id&&msgs.querySelector('.bubble[data-id="'+m.id+'"]'))return;
  const d=document.createElement('div');
  d.className='bubble '+(incoming?'in':'out');
  if(m.id)d.dataset.id=m.id;
  d.dataset.reactions=JSON.stringify(m.reactions||{});
  if(m.deleted_at){d.classList.add('deleted');d.innerHTML='<i>This message was deleted</i>';msgs.appendChild(d);scrollBottom();return;}
  if(m.pinned)d.classList.add('pinned');

  const star = (m.starred_by||[]).includes(me.id) ? '<span class="star-mark">⭐</span>' : '';
  const reply = m.reply_to_id && m.reply_body ? `<div class="reply-quote"><b>${esc(m.reply_sender||'')}</b><br>${esc(m.reply_body).slice(0,120)}</div>` : '';
  const edited = m.edited_at ? ' <i style="opacity:.55;font-size:11px">(edited)</i>' : '';
  const receipt = !incoming ? `<span class="receipt">${m.read_at?'✓✓':'✓'}</span>` : '';

  if(m.media_url){
    d.classList.add('media');
    let inner='';
    if(m.media_type==='image')inner=`<img src="${m.media_url}" onclick="openLightbox('image','${m.media_url}')">`;
    else if(m.media_type==='video')inner=`<video src="${m.media_url}" controls></video>`;
    else if(m.media_type==='audio')inner=`<audio src="${m.media_url}" controls></audio>`;
    else inner=`<a href="${m.media_url}" target="_blank" style="color:#7b8cff">📎 Download file</a>`;
    d.innerHTML=reply+star+inner+(m.body?`<div class="caption">${linkify(m.body)}</div>`:'')+`<span class="t">${timeShort(m.created_at)}${receipt}</span>`;
  } else {
    d.innerHTML=reply+star+linkify(m.body)+edited+`<span class="t">${timeShort(m.created_at)}${receipt}</span>`;
  }

  const toggle=document.createElement('button');
  toggle.className='react-toggle';toggle.textContent='☺';
  toggle.onclick=e=>{e.stopPropagation();showReactionPicker(m.id,e.clientX,e.clientY);};
  d.appendChild(toggle);

  // long press for actions
  let pressTimer;
  const openActions=(x,y)=>{showMessageActions(m,x,y);};
  d.addEventListener('contextmenu',e=>{e.preventDefault();openActions(e.clientX,e.clientY);});
  d.addEventListener('touchstart',e=>{const t=e.touches[0];pressTimer=setTimeout(()=>openActions(t.clientX,t.clientY),500);});
  d.addEventListener('touchend',()=>clearTimeout(pressTimer));
  d.addEventListener('touchmove',()=>clearTimeout(pressTimer));

  msgs.appendChild(d);
  renderReacts(d,m.reactions||{});
  scrollBottom();
}

/* ACTION MENU */
function showReactionPicker(msgId,x,y){
  const menu=document.getElementById('popmenu');
  menu.innerHTML=`<div class="emoji-row">${['❤️','👍','😂','😮','😢','🙏'].map(e=>`<button onclick="reactTo(${msgId},'${e}')">${e}</button>`).join('')}</div>`;
  menu.style.left=Math.min(x,window.innerWidth-260)+'px';
  menu.style.top=Math.min(y,window.innerHeight-120)+'px';
  menu.classList.add('show');
}
function showMessageActions(m,x,y){
  const menu=document.getElementById('popmenu');
  const mine=Number(m.sender_id)===Number(me.id);
  const starred=(m.starred_by||[]).includes(me.id);
  menu.innerHTML=`
    <button onclick="startReply(${m.id});closePop()">↩ Reply</button>
    <button onclick="forwardMsg(${m.id});closePop()">➡ Forward</button>
    <button onclick="copyText('${(m.body||'').replace(/'/g,'')}');closePop()">📋 Copy</button>
    <button onclick="toggleStar(${m.id});closePop()">${starred?'☆ Unstar':'⭐ Star'}</button>
    <button onclick="togglePin(${m.id});closePop()">${m.pinned?'📌 Unpin':'📌 Pin'}</button>
    ${mine?`<button onclick="editMsg(${m.id});closePop()">✏ Edit</button>`:''}
    ${mine?`<button onclick="deleteMsg(${m.id});closePop()">🗑 Delete</button>`:''}
    ${!mine?`<button onclick="blockUser(${m.sender_id});closePop()">🚫 Block</button>`:''}
  `;
  menu.style.left=Math.min(x,window.innerWidth-220)+'px';
  menu.style.top=Math.min(y,window.innerHeight-380)+'px';
