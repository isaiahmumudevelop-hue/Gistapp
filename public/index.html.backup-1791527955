    body.innerHTML =
      '<div style="padding:16px;text-align:center;color:var(--sub);font-size:14px;line-height:1.6">' +
        '✅ Two-step verification is <b style="color:#25d366">ON</b>.<br>' +
        'You\'ll need your authenticator code each time you log in.' +
      '</div>' +
      '<button class="picker-row danger" onclick="disable2FA()">🔓 Turn off 2FA</button>';
    return;
  }

  body.innerHTML = '<div style="padding:20px;text-align:center;color:var(--sub)">Generating QR code…</div>';
  try {
    const data = await api('/api/2fa/setup', { method:'POST' });
    body.innerHTML =
      '<div style="padding:8px 4px;font-size:13.5px;color:var(--sub);line-height:1.6;text-align:center">' +
        'Scan this QR code with <b>Google Authenticator</b>, <b>Authy</b> or any 2FA app.' +
      '</div>' +
      '<div style="text-align:center;padding:12px 0">' +
        '<img src="' + data.qr + '" style="width:200px;height:200px;border-radius:14px;background:#fff;padding:8px">' +
      '</div>' +
      '<div style="padding:10px 4px;font-size:13px;color:var(--sub);text-align:center">' +
        'Or enter this key manually:<br>' +
        '<code style="display:inline-block;margin-top:6px;background:var(--bg-3);padding:8px 12px;border-radius:10px;font-size:12px;letter-spacing:1px">' + data.secret + '</code>' +
      '</div>' +
      '<div style="padding:12px 0 4px">' +
        '<input id="totp-code" placeholder="Enter 6-digit code" inputmode="numeric" maxlength="6" ' +
          'style="width:100%;height:52px;border-radius:14px;border:1.5px solid var(--line);background:var(--bg-2);padding:0 16px;font-size:18px;color:var(--ink);outline:none;text-align:center;letter-spacing:6px;font-family:monospace">' +
      '</div>' +
      '<div id="totp-err" style="min-height:16px;color:#e5484d;font-size:12.5px;text-align:center;font-weight:600;margin-bottom:6px"></div>' +
      '<button class="picker-row" style="background:#7b8cff;color:#fff;justify-content:center;font-weight:700" onclick="confirm2FA()">Enable 2FA</button>';
    setTimeout(()=>{ const el = document.getElementById('totp-code'); if (el) el.focus(); }, 200);
  } catch(e){
    body.innerHTML = '<div style="padding:20px;color:#e5484d;text-align:center">' + esc(e.message) + '</div>';
  }
}

async function confirm2FA(){
  const code = (document.getElementById('totp-code').value || '').trim();
  const err = document.getElementById('totp-err');
  if (!code || code.length !== 6){ err.textContent = 'Enter the 6-digit code'; return; }
  try {
    await api('/api/2fa/enable', { method:'POST', body: JSON.stringify({ code }) });
    me.totp_enabled = true;
    closePicker();
    if (typeof toast === 'function') toast('Two-step verification enabled');
  } catch(e){ err.textContent = e.message; }
}

async function disable2FA(){
  const password = prompt('Enter your account password to turn off 2FA:');
