/* ================= CONTACT PROFILE ================= */
let cpChat = null;
let cpDisappearOn = false;

async function openContactProfile(){
  if (!currentChat) return;
  cpChat = currentChat;
  const name = displayName(cpChat);
  const color = cpChat.other_color || colorFor(name);

  const av = document.getElementById('cp-avatar');
  if (cpChat.other_url){
    av.textContent = '';
    av.style.background = 'url(' + cpChat.other_url + ') center/cover';
  } else {
    av.textContent = initials(name);
    av.style.background = color;
  }

  document.getElementById('cp-name').textContent = name;
  document.getElementById('cp-email').textContent = cpChat.other_email || 'Email hidden';

  const isOnline = cpChat.other_id && onlineIds.has(Number(cpChat.other_id));
  document.getElementById('cp-online-dot').style.display = isOnline ? 'block' : 'none';
  document.getElementById('cp-badge-online').style.display = isOnline ? 'inline-block' : 'none';
  document.getElementById('cp-badge-contact').textContent = cpChat.type === 'group' ? 'Group' : 'Contact';

  const status = document.getElementById('cp-lastseen');
  if (cpChat.other_status === 'pending') status.textContent = 'Waiting for them to accept';
  else if (isOnline) status.textContent = 'Online';
  else status.textContent = 'Last seen recently';

  // Mute
  document.getElementById('cp-mute').classList.toggle('on', !!cpChat.muted);

  // Favorite / Archive labels
  document.getElementById('cp-fav-label').textContent = cpChat.favorite ? 'Remove from favorites' : 'Add to favorites';
  document.getElementById('cp-arch-label').textContent = cpChat.archived ? 'Unarchive chat' : 'Archive chat';

  // Block label
  const blkLabel = document.getElementById('cp-block-label');
  if (blkLabel) blkLabel.textContent = cpIsBlocked() ? 'Unblock contact' : 'Block contact';

  // Media
  loadContactMedia();

  show('screen-contact');
}

function closeContactProfile(){
  if (currentChat) show('screen-dm');
  else show('screen-list');
}

async function loadContactMedia(){
  const grid = document.getElementById('cp-media-grid');
  const countEl = document.getElementById('cp-media-count');
  grid.innerHTML = '';
  try {
    const rows = await api('/api/chats/' + cpChat.id + '/messages');
    const media = rows.filter(m => m.media_url && m.media_type === 'image').slice(-4);
    if (!media.length){
      grid.innerHTML = '<div style="grid-column:1/-1;color:var(--sub);font-size:13px;padding:8px 0">No media yet</div>';
      countEl.textContent = '›';
      return;
    }
    grid.innerHTML = media.map(m =>
      `<div class="cp-thumb" onclick="openLightbox('image','${m.media_url}')"><img src="${m.media_url}"></div>`
    ).join('');
    countEl.textContent = (rows.filter(m => m.media_url).length) + ' ›';
  } catch(e){
    grid.innerHTML = '<div style="grid-column:1/-1;color:var(--sub);font-size:13px">Could not load media</div>';
  }
}

async function cpToggleMute(){
  const next = !cpChat.muted;
  try {
    await api('/api/chats/' + cpChat.id, { method:'PATCH', body: JSON.stringify({ muted: next }) });
    cpChat.muted = next;
    document.getElementById('cp-mute').classList.toggle('on', next);
    const found = chatsCache.find(c => Number(c.id) === Number(cpChat.id));
    if (found) found.muted = next;
    renderChats();
    toast(next ? 'Chat muted' : 'Chat unmuted');
  } catch(e){ alert(e.message); }
}

function cpToggleDisappear(){
  cpDisappearOn = !cpDisappearOn;
  document.getElementById('cp-disappear').classList.toggle('on', cpDisappearOn);
  document.getElementById('cp-disappear-sub').textContent = cpDisappearOn ? '24 hours' : 'Off';
  toast(cpDisappearOn ? 'Disappearing messages: 24 hours (coming soon)' : 'Disappearing messages: Off');
}

async function cpToggleFavorite(){
  const next = !cpChat.favorite;
  try {
    await api('/api/chats/' + cpChat.id, { method:'PATCH', body: JSON.stringify({ favorite: next }) });
    cpChat.favorite = next;
    document.getElementById('cp-fav-label').textContent = next ? 'Remove from favorites' : 'Add to favorites';
    const found = chatsCache.find(c => Number(c.id) === Number(cpChat.id));
    if (found) found.favorite = next;
    renderChats();
    toast(next ? 'Added to favorites' : 'Removed from favorites');
  } catch(e){ alert(e.message); }
}

async function cpToggleArchive(){
  const next = !cpChat.archived;
  try {
    await api('/api/chats/' + cpChat.id, { method:'PATCH', body: JSON.stringify({ archived: next }) });
    cpChat.archived = next;
    document.getElementById('cp-arch-label').textContent = next ? 'Unarchive chat' : 'Archive chat';
    const found = chatsCache.find(c => Number(c.id) === Number(cpChat.id));
    if (found) found.archived = next;
    renderChats();
    toast(next ? 'Chat archived' : 'Chat unarchived');
  } catch(e){ alert(e.message); }
}

async function cpBlock(){
  if (!cpChat || !cpChat.other_id){ toast('Cannot block in this chat'); return; }
  const currentlyBlocked = cpIsBlocked();
  const label = currentlyBlocked ? 'Unblock this contact?' : 'Block this contact?';
  if (!confirm(label)) return;
  try {
    const r = await api('/api/users/' + cpChat.other_id + '/block', { method:'POST' });
    // refresh my user data
    try { me = await api('/api/me'); } catch(_){}
    toast(r.blocked ? 'Contact blocked' : 'Contact unblocked');
    // refresh chat list to hide/show messages
    if (typeof loadChats === 'function') loadChats();
  } catch(e){ alert(e.message); }
}

async function cpReport(){
  if (!cpChat || !cpChat.other_id){ if (typeof toast==='function') toast('Cannot report'); return; }
  const reason = prompt('Why are you reporting this user?');
  if (!reason || !reason.trim()) return;
  try {
    await api('/api/users/' + cpChat.other_id + '/report', { method:'POST', body: JSON.stringify({ reason: reason.trim() }) });
    if (typeof toast==='function') toast('Report sent — thank you');
  } catch(e){ alert(e.message); }
}

