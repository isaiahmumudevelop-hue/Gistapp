/* universal toggle switch (settings, profile, contact, pickers) */
.sw,
.pf-switch,
.cp-switch{
  width:50px;
  height:30px;
  min-width:50px;
  border-radius:999px;
  background:#3a3a3e;
  border:0;
  padding:0;
  position:relative;
  cursor:pointer;
  flex-shrink:0;
  transition:background .2s;
  display:inline-block;
  vertical-align:middle;
}
body:not(.dark) .sw,
body:not(.dark) .pf-switch,
body:not(.dark) .cp-switch{
  background:#d1d1d6;
}
.sw::after,
.pf-switch::after,
.cp-switch::after{
  content:"";
  position:absolute;
  top:3px;
  left:3px;
  width:24px;
  height:24px;
  border-radius:50%;
  background:#fff;
  transition:transform .2s;
  box-shadow:0 1px 3px rgba(0,0,0,.3);
}
.sw.on,
.pf-switch.on,
.cp-switch.on{
  background:#25d366;
}
.sw.on::after,
.pf-switch.on::after,
.cp-switch.on::after{
  transform:translateX(20px);
}
/* picker toggle rows (advanced etc.) */
.picker-toggle .sw{
  margin-left:12px;
}

/* ensure toggle sits at the right edge of the row */
.srow .sw,
.srow .sw.on{
  flex-shrink:0;
  margin-left:8px;
}


/* profile exit button */
.pf-exit{
  position:absolute;top:calc(14px + var(--safe-t));right:14px;
  width:42px;height:42px;border-radius:50%;
  background:rgba(0,0,0,.4);color:#fff;border:none;
  display:flex;align-items:center;justify-content:center;
  cursor:pointer;backdrop-filter:blur(8px);z-index:30;
}
.pf-exit:active{transform:scale(.94)}

/* edit-cover button */
.pf-edit-cover{
  position:absolute;top:calc(14px + var(--safe-t));right:70px;
  width:42px;height:42px;border-radius:50%;
  background:rgba(0,0,0,.4);color:#fff;border:none;
  display:flex;align-items:center;justify-content:center;
  cursor:pointer;backdrop-filter:blur(8px);z-index:30;
}
.pf-edit-cover:active{transform:scale(.94)}

/* cover hint */
.pf-cover-hint{
  position:absolute;left:50%;top:55%;transform:translate(-50%,-50%);
  font-size:11.5px;color:rgba(255,255,255,.85);
  font-weight:600;text-align:center;
  padding:6px 12px;border-radius:20px;
  background:rgba(0,0,0,.35);
  opacity:0;transition:opacity .2s;pointer-events:none;
}
.pf-gradient:hover .pf-cover-hint{opacity:1}

/* avatar edit pencil */
.pf-avatar-edit{
  position:absolute;bottom:2px;left:2px;
  width:26px;height:26px;border-radius:50%;
  background:#7b8cff;color:#fff;
  display:flex;align-items:center;justify-content:center;
  border:2.5px solid var(--bg);
  z-index:12;
}

/* bio edit chip */
.pf-bio-edit{
  display:inline-flex;align-items:center;gap:5px;
  margin:8px auto 0;padding:5px 12px;border-radius:14px;
  background:var(--bg-2);color:var(--sub);
  font-size:11.5px;font-weight:600;cursor:pointer;
  text-align:center;
}
.pf-bio-edit:active{background:var(--bg-3)}
body:not(.dark) .pf-bio-edit{background:#f0f0f3}

/* make avatar pointer show */
.pf-avatar-wrap{cursor:pointer}
.pf-gradient{cursor:pointer}


.or-divider{display:flex;align-items:center;gap:12px;margin:16px 0;color:#c7c7cc;font-size:12px;font-weight:600}
.or-divider::before,.or-divider::after{content:"";flex:1;height:1px;background:#e8e5f0}
.google-wrap{display:flex;justify-content:center;margin-bottom:8px}

/* ONBOARDING */
#screen-onboarding{background:linear-gradient(160deg,#8b8fd6 0%,#b3a9dd 55%,#f4f1ff 100%);z-index:32;overflow-y:auto}
.ob-wrap{min-height:100%;display:flex;align-items:center;justify-content:center;padding:24px;padding-top:calc(24px + var(--safe-t));padding-bottom:calc(24px + var(--safe-b))}
.ob-step{width:100%;max-width:460px;background:#fff;border-radius:28px;padding:28px 22px;box-shadow:0 30px 70px rgba(30,25,60,.25);color:#1c1c22}
.ob-prog{display:flex;gap:6px;justify-content:center;margin-bottom:20px}
.ob-prog span{height:4px;flex:1;max-width:44px;background:#e8e5f0;border-radius:2px}
.ob-prog span.on{background:#7b8cff}
.ob-title{font-size:22px;font-weight:800;color:#1c1c22;margin:0 0 6px;text-align:center;letter-spacing:-.4px}
.ob-sub{font-size:13.5px;color:#8e8e96;margin:0 0 22px;line-height:1.5;text-align:center}
.ob-avatar-wrap{display:flex;flex-direction:column;align-items:center;margin:8px 0 18px;cursor:pointer}
.ob-avatar{width:96px;height:96px;border-radius:50%;background:linear-gradient(135deg,#7b8cff,#b58cff);display:flex;align-items:center;justify-content:center;color:#fff;font-size:34px;font-weight:700;background-size:cover;background-position:center;border:4px solid #f0edf5}
.ob-avatar-hint{display:inline-flex;align-items:center;gap:5px;margin-top:10px;font-size:12.5px;color:#6a62b8;font-weight:700}
.ob-field{margin-bottom:14px}
.ob-field label{display:block;font-size:11.5px;font-weight:700;color:#8e8e96;text-transform:uppercase;letter-spacing:.4px;margin-bottom:6px}
.ob-field input,.ob-field textarea{width:100%;border:1.5px solid #e8e5f0;background:#faf9fd;border-radius:14px;padding:14px 16px;font-size:15px;color:#1c1c22;outline:none;font-family:inherit;resize:none}
.ob-field input:focus,.ob-field textarea:focus{border-color:#8b8fd6;background:#fff}
.ob-field input.ok{border-color:#25d366}
.ob-field input.err{border-color:#e5484d}
.ob-status{font-size:12px;margin-top:6px;font-weight:600}
.ob-status.ok{color:#25d366}
.ob-status.err{color:#e5484d}
.ob-opt{color:#c7c7cc;font-weight:500;text-transform:none;letter-spacing:0}
.ob-suggest{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.ob-suggest button{padding:6px 12px;border-radius:14px;background:#f0edf5;border:none;font-size:12px;font-weight:600;color:#6a62b8;cursor:pointer;font-family:inherit}
.ob-btn{width:100%;height:54px;background:#14141a;color:#fff;border:none;border-radius:16px;font-size:15px;font-weight:700;cursor:pointer;margin-top:8px}
.ob-btn:disabled{opacity:.5;cursor:not-allowed}
.ob-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:18px}
.ob-chip{padding:14px 6px;border-radius:16px;background:#faf9fd;border:2px solid #e8e5f0;font-size:12.5px;font-weight:600;color:#4a4568;cursor:pointer;text-align:center;font-family:inherit;display:flex;flex-direction:column;align-items:center;gap:6px}
.ob-chip .ic{font-size:22px}
.ob-chip.on{background:#eef1ff;border-color:#7b8cff;color:#4a55b8}
.ob-tabs{display:flex;gap:6px;margin-bottom:14px;background:#f2f1f7;padding:4px;border-radius:14px}
.ob-tabs button{flex:1;padding:10px;border-radius:10px;background:transparent;border:none;font-size:12.5px;font-weight:700;color:#8e8e96;cursor:pointer;font-family:inherit}
.ob-tabs button.on{background:#fff;color:#1c1c22}
.ob-list{max-height:280px;overflow-y:auto;margin-bottom:16px}
.ob-item{display:flex;align-items:center;gap:12px;padding:12px;border-radius:14px;background:#faf9fd;margin-bottom:8px;border:1.5px solid #e8e5f0}
.ob-item.on{background:#eef1ff;border-color:#7b8cff}
.ob-item .av{width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,#7b8cff,#b58cff);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:14px;flex-shrink:0}
.ob-item .info{flex:1;min-width:0}
.ob-item .info b{font-size:14px;color:#1c1c22;display:block}
.ob-item .info small{font-size:12px;color:#8e8e96;display:block;margin-top:2px}
.ob-item .join{background:#14141a;color:#fff;border:none;padding:8px 14px;border-radius:12px;font-size:12px;font-weight:700;cursor:pointer;font-family:inherit}
.ob-item.on .join{background:#25d366}
.ob-perm{display:flex;align-items:flex-start;gap:14px;padding:16px;border-radius:16px;background:#faf9fd;border:1.5px solid #e8e5f0;margin-bottom:12px;cursor:pointer}
.ob-perm.on{background:#eef1ff;border-color:#7b8cff}
.ob-perm .ic{width:42px;height:42px;border-radius:50%;background:#eef1ff;color:#7b8cff;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:20px}
.ob-perm .info b{font-size:14px;color:#1c1c22;display:block;margin-bottom:3px}
.ob-perm .info small{font-size:12px;color:#8e8e96;line-height:1.5}
.ob-skip{text-align:center;font-size:13px;color:#8e8e96;font-weight:600;margin-top:14px;cursor:pointer;padding:8px}

/* CALL OVERLAY */
.call-overlay{position:fixed;inset:0;background:linear-gradient(180deg,#1c1c22 0%,#2a2740 100%);z-index:500;display:none;flex-direction:column;color:#fff;overflow:hidden}
.call-overlay.show{display:flex}
.call-bg{position:absolute;inset:0;background:linear-gradient(180deg,#1c1c22 0%,#2a2740 100%);z-index:0}
.call-video-wrap{position:absolute;inset:0;z-index:1}
.call-video-wrap #call-remote-video{width:100%;height:100%;object-fit:cover;background:#000}
.call-video-wrap #call-local-video{position:absolute;top:calc(20px + var(--safe-t));right:20px;width:120px;height:160px;border-radius:16px;object-fit:cover;background:#111;box-shadow:0 8px 24px rgba(0,0,0,.5);transform:scaleX(-1)}
.call-ui{position:relative;z-index:2;flex:1;display:flex;flex-direction:column;align-items:center;justify-content:space-between;padding:calc(60px + var(--safe-t)) 24px calc(50px + var(--safe-b))}
.call-avatar{width:120px;height:120px;border-radius:50%;background:linear-gradient(135deg,#7b8cff,#b58cff);display:flex;align-items:center;justify-content:center;font-size:46px;font-weight:700;color:#fff;background-size:cover;background-position:center;box-shadow:0 20px 60px rgba(0,0,0,.5)}
.call-name{font-size:26px;font-weight:700;margin-top:24px;text-align:center}
.call-status{font-size:14px;opacity:.7;margin-top:8px;text-align:center}
.call-timer{font-size:16px;font-variant-numeric:tabular-nums;opacity:.9;margin-top:6px;text-align:center;min-height:22px}
.call-actions{display:flex;gap:24px;justify-content:center;align-items:center}
.call-act{width:66px;height:66px;border-radius:50%;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;color:#fff}
.call-act.accept{background:#25d366}
.call-act.reject{background:#ff3b30}
.call-act.end{background:#ff3b30}
.call-act.mute{background:rgba(255,255,255,.15)}
.call-act.mute.on{background:#ffd60a;color:#1c1c22}
.call-act.camera{background:rgba(255,255,255,.15)}
.call-act.camera.off{background:#ffd60a;color:#1c1c22}

/* CALLS TAB */
#screen-calls{background:var(--bg)}
.call-item{display:flex;align-items:center;gap:14px;padding:14px 20px;cursor:pointer;border-bottom:1px solid var(--line)}
.call-item .avatar{width:50px;height:50px;font-size:16px;flex-shrink:0;background-size:cover;background-position:center}
.call-item .info{flex:1;min-width:0}
.call-item .info b{font-size:15px;color:var(--ink);font-weight:600;display:block}
.call-item .info small{font-size:12.5px;color:var(--sub);display:block;margin-top:2px}
.call-item .meta{text-align:right;flex-shrink:0;display:flex;flex-direction:column;align-items:flex-end;gap:4px}
.call-item .meta .time{font-size:11.5px;color:#b9b6c2}
.call-item .meta .dur{font-size:11.5px;color:var(--sub)}
.call-item.missed .info b{color:#ff3b30}
.call-empty{padding:50px 20px;text-align:center;color:var(--sub);font-size:14px;line-height:1.6}


.call-item-actions{display:flex;gap:8px;align-items:center;flex-shrink:0}
.call-back-btn{
  width:38px;height:38px;border-radius:50%;
  background:var(--bg-2);border:none;cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  color:var(--ink);transition:transform .12s,background .15s;
}
.call-back-btn:hover{background:var(--bg-3)}
.call-back-btn:active{transform:scale(.92)}
body.dark .call-back-btn{background:#232230;color:#f2f0fa}
body.dark .call-back-btn:hover{background:#2a2936}

.disappear-indicator{
  display:inline-flex;align-items:center;gap:4px;
  padding:5px 10px;border-radius:14px;
  background:rgba(255,255,255,.22);color:#fff;
  font-size:11px;font-weight:700;border:none;cursor:pointer;
  flex-shrink:0;backdrop-filter:blur(6px);
  transition:background .15s;
}
.disappear-indicator:active{background:rgba(255,255,255,.35)}
body.dark .disappear-indicator{background:rgba(255,255,255,.12)}
.disappear-indicator svg{opacity:.85}
</style>
</head>
<body>

<div class="app">

  <!-- AUTH -->
  <section class="screen" id="screen-auth">
    <div class="auth-card">
      <h1 id="auth-title">Welcome back</h1>
      <p id="auth-sub">Chat by email — no phone number needed.</p>
      <div class="err" id="auth-err"></div>
      <input id="auth-name" type="text" placeholder="Display name" style="display:none">
      <input id="auth-email" type="email" placeholder="you@example.com" spellcheck="false">
      <input id="auth-pass" type="password" placeholder="Password">
      <button class="auth-btn" id="auth-btn">Log in</button>
      <div class="or-divider"><span>or</span></div>
      <div class="google-wrap" id="google-signin-wrap">
        <div id="g_id_onload"
             data-client_id="780625387979-t2nc3vkeme7muo85m1itchefv90hd12o.apps.googleusercontent.com"
             data-callback="handleGoogleCredential"
             data-auto_prompt="false"></div>
        <div class="g_id_signin"
             data-type="standard" data-size="large" data-theme="filled_black"
             data-text="continue_with" data-shape="pill" data-logo_alignment="left"
             data-width="320"></div>
      </div>
      <div class="auth-swap"><span id="auth-swap-text">Don't have an account?</span> <a id="auth-swap-link">Sign up</a></div>
    </div>
  </section>

  <!-- LIST -->
  <section class="screen" id="screen-list">
    <div class="list-top">
      <div class="search-row">
        <div class="search-pill">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
          <input id="search" type="text" placeholder="Search chats">
        </div>
        <button class="icon-btn" style="background:rgba(255,255,255,.38);color:#fff" onclick="openSheet()">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="19" cy="12" r="1.8"/></svg>
        </button>
      </div>
      <h1 class="list-title">Let's Stay<br>Connected</h1>
    </div>
    <div class="stories" id="stories"></div>
    <div class="chats-head"><h2>Chats</h2>
      <button class="icon-btn" style="background:var(--bg-2);color:#6a6280" onclick="openSheet()">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="19" cy="12" r="1.8"/></svg>
      </button>
    </div>
    <div class="filters" id="filters"></div>
    <div class="requests-wrap" id="requests"></div>
    <div class="chat-scroll" id="chat-scroll"></div>
    <nav class="bottom-nav">
      <div class="nav-ic" onclick="openUpdates()" aria-label="Updates">
        <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="3.5" fill="currentColor"/><path d="M12 4.5v1.5M12 18v1.5M4.5 12H6M18 12h1.5"/></svg>
      </div>
      <button class="new-chat-btn" onclick="openSheet()">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
        New Chat
      </button>
      <div class="nav-ic" onclick="openCallsTab()" aria-label="Calls">
        <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 3.5h3l1.5 4-2 1.5a12 12 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.7a2 2 0 0 1 2-2.2z"/></svg>
      </div>
      <div class="nav-ic" onclick="openSettings()" aria-label="Settings">
        <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M12 3.5v2M12 18.5v2M3.5 12h2M18.5 12h2M6 6l1.4 1.4M16.6 16.6 18 18M18 6l-1.4 1.4M7.4 16.6 6 18"/></svg>
      </div>
    </nav>
    <div class="e2e-footer">🔒 Your personal messages are end-to-end encrypted</div>
  </section>

  <!-- DM -->
  <section class="screen" id="screen-dm">
    <div class="dm-header">
      <button class="icon-btn" onclick="goList()">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg>
      </button>
      <div class="avatar" id="dm-avatar">?</div>
      <div class="who" onclick="openContactProfile()">
        <b id="dm-name">…</b>
        <small id="dm-status">Offline</small>
      </div>
      <button class="disappear-indicator" id="disappear-indicator" onclick="openDisappearPicker()" style="display:none" title="Disappearing messages ON">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        <span id="disappear-label">24h</span>
      </button>
      <div class="spacer"></div>
      <button class="icon-btn" onclick="startCall('audio')" aria-label="Audio call">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 3.5h3l1.5 4-2 1.5a12 12 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.7a2 2 0 0 1 2-2.2z"/></svg>
      </button>
      <button class="icon-btn" onclick="startCall('video')" aria-label="Video call">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="13" height="12" rx="2.5"/><path d="M16 10.5l5-2.5v8l-5-2.5"/></svg>
      </button>
      <button class="icon-btn" onclick="openChatMenu(event)">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="12" cy="19" r="1.8"/></svg>
      </button>
    </div>
    <div class="search-bar" id="chat-search-bar" style="padding:0 16px 8px;display:none">
      <input id="chat-search-input" placeholder="Search in this chat…" style="width:100%;height:40px;border-radius:20px;border:none;background:rgba(255,255,255,.65);padding:0 16px;font-size:14px;outline:none">
    </div>
    <div class="dm-body" id="dm-body">
      <div class="time-chip">Today</div>
      <div id="dm-messages"></div>
      <div class="typing-pill" id="dm-typing">
        <div class="avatar" id="dm-typing-av" style="background:var(--grad-1)">?</div>
        <span id="dm-typing-name">Someone</span> is typing…<span class="dots"><i></i><i></i><i></i></span>
      </div>
    </div>
    <div class="reply-bar" id="reply-bar">
      <b id="reply-name">Reply</b>
      <span id="reply-text"></span>
      <button class="close" onclick="cancelReply()">✕</button>
    </div>
    <form class="dm-input" id="dm-form">
      <button type="button" class="attach" onclick="pickFile()">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.5l-8.2 8.2a5.5 5.5 0 01-7.8-7.8l8.6-8.6a3.7 3.7 0 015.2 5.2l-8.4 8.4a1.85 1.85 0 01-2.6-2.6l7.8-7.8"/></svg>
      </button>
      <input type="file" id="file-pick" hidden>
      <input type="text" id="dm-text" placeholder="Your Message…" autocomplete="off">
      <button class="send-dark" type="submit">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-left:-2px"><path d="M21 3L10.5 13.5"/><path d="M21 3l-7 18-3.5-7.5L3 10z"/></svg>
      </button>
    </form>
    <div class="waiting-bar" id="waiting-bar" style="display:none">Request sent — waiting for them to accept…</div>
  </section>

  <!-- SHEET -->
  <div class="backdrop" id="backdrop" onclick="closeSheet();closeCallPicker()"></div>
  <div class="sheet" id="sheet">
    <div class="grab"></div>
    <div class="sheet-opt" onclick="openNewChat()">
      <div class="ic"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 01-8.5 8.3 8.6 8.6 0 01-3.7-.8L3 20l1-5.6a8.1 8.1 0 01-.9-3.8A8.4 8.4 0 0111.5 2.3 8.4 8.4 0 0121 11.5z"/></svg></div>
      <div><b>New Chat</b><small>Start a chat by email</small></div>
    </div>
    <div class="sheet-opt" onclick="openNewGroup()">
      <div class="ic"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-5.8 6.5-5.8s6.5 2.2 6.5 5.8"/><path d="M18 8v6M15 11h6"/></svg></div>
      <div><b>New Group</b><small>Create a group with multiple emails</small></div>
    </div>
    <div class="sheet-opt" onclick="openProfile();closeSheet()">
      <div class="ic"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"/></svg></div>
      <div><b>My Profile</b><small>Name, color, theme, font, DND</small></div>
    </div>
    <button class="cancel-btn" onclick="closeSheet()">Cancel</button>
  </div>

