  appId: "1:839270673363:web:ae835e18fd9992ceac9d26"
};

let db = null;
try {
  const app = initializeApp(firebaseConfig);
  db = getDatabase(app);
  window._fbReady = true;
} catch(e){
  console.warn('Firebase failed to init:', e);
  window._fbReady = false;
}

let presenceUnsub = null;

window._fbStartPresence = function(userId){
  if (!db || !userId) return;
  try {
    const myRef = ref(db, 'presence/' + userId);

    // Mark online
    set(myRef, { online: true, last_seen: Date.now() });

    // Server-side onDisconnect — fires even if phone dies or tab is killed
    onDisconnect(myRef).set({ online: false, last_seen: Date.now() });

    // Listen to everyone's presence
    if (presenceUnsub) presenceUnsub();
    presenceUnsub = onValue(ref(db, 'presence'), (snap) => {
      const data = snap.val() || {};
      const online = [];
      for (const uid in data) {
        if (data[uid] && data[uid].online) online.push(Number(uid));
      }
      if (typeof window._onPresenceUpdate === 'function') {
        window._onPresenceUpdate(online);
      }
    });
  } catch(e){ console.warn('presence error:', e); }
};

window._fbStopPresence = function(userId){
  if (!db || !userId) return;
  try {
    set(ref(db, 'presence/' + userId), { online: false, last_seen: Date.now() });
    if (presenceUnsub) { presenceUnsub(); presenceUnsub = null; }
  } catch(e){}
};
