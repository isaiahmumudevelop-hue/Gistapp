    inp.classList.remove('ok'); inp.classList.add('err');
    if (btn) btn.disabled = true;
    obFetchSuggestions(u.replace(/[^a-z0-9_]/g,''));
    return;
  }
  try {
    const r = await api('/api/username/set', { method:'POST', body: JSON.stringify({ username: u }) });
    status.className='ob-status ok'; status.textContent='@'+r.username+' is available';
    inp.classList.remove('err'); inp.classList.add('ok');
    if (btn) btn.disabled = false;
  } catch(e){
    status.className='ob-status err'; status.textContent = e.message;
    inp.classList.remove('ok'); inp.classList.add('err');
    if (btn) btn.disabled = true;
    obFetchSuggestions(u.replace(/[^a-z0-9_]/g,''));
  }
}
function obNextStep1(){ OB_STATE.step=2; obRender(); }
async function obNextStep2(){
  const v = (document.getElementById('ob-birthday').value||'').trim();
  if (!v){ alert('Enter your birthday'); return; }
  const dob = new Date(v);
  const age = Math.floor((Date.now()-dob.getTime())/(365.25*24*3600*1000));
  if (age < 18){ alert('You must be 18 or older.'); return; }
  OB_STATE.birthday = v;
  await obSaveProfile();
  OB_STATE.step = 3; obRender();
}
function obToggleInterest(id){
  const i = OB_STATE.interests.indexOf(id);
  if (i === -1) OB_STATE.interests.push(id); else OB_STATE.interests.splice(i,1);
  document.querySelectorAll('.ob-chip').forEach(el => el.classList.toggle('on', OB_STATE.interests.includes(el.getAttribute('data-id')||el.textContent.trim())));
  const btn = document.getElementById('ob-int-btn'); if (btn) btn.disabled = OB_STATE.interests.length < 3;
}
async function obNextStep3(){
  if (OB_STATE.interests.length < 3){ alert('Pick at least 3'); return; }
  await api('/api/onboard/interests', { method:'POST', body: JSON.stringify({ interests: OB_STATE.interests }) });
  OB_STATE.step = 4; obRender();
}
function obPickTab(t){ window._obPickTab = t; obRender(); }
function obTogglePick(tab, id){
  const arr = tab === 'communities' ? OB_STATE.joined_communities : OB_STATE.follows;
  const i = arr.indexOf(id); if (i === -1) arr.push(id); else arr.splice(i,1);
  obRender();
}
async function obNextStep4(){
  await api('/api/onboard/picks', { method:'POST', body: JSON.stringify({ follows: OB_STATE.follows, joined_communities: OB_STATE.joined_communities }) });
  OB_STATE.step = 5; obRender();
}
function obTogglePerm(k){
  OB_STATE.permissions[k] = !OB_STATE.permissions[k];
  obRender();
  if (k === 'notifications' && OB_STATE.permissions.notifications && typeof Notification !== 'undefined' && Notification.requestPermission) Notification.requestPermission();
}
async function obFinish(){
  try {
    const r = await api('/api/onboard/permissions', { method:'POST', body: JSON.stringify({ permissions: OB_STATE.permissions }) });
    me = Object.assign({}, me, r, { onboarded: true });
    if (typeof toast === 'function') toast('Welcome to GistApp');
    await enterApp();
  } catch(e){ alert(e.message); }
}
async function obSkip(step){
  if (step === 2) await obSaveProfile();
  if (step === 3) await api('/api/onboard/interests', { method:'POST', body: JSON.stringify({ interests: OB_STATE.interests }) }).catch(()=>{});
  OB_STATE.step = step + 1; obRender();
}
async function obSaveProfile(){
  try {
    const r = await api('/api/onboard/profile', { method:'POST', body: JSON.stringify({
      display_name: OB_STATE.display_name, bio: OB_STATE.bio, avatar_url: OB_STATE.avatar_url, birthday: OB_STATE.birthday
    })});
    me = Object.assign({}, me, r);
  } catch(e){ alert(e.message); throw e; }
}
function showOnboarding(){
  OB_STATE.step = 0; OB_STATE.username=''; OB_STATE.display_name=''; OB_STATE.bio='';
  OB_STATE.avatar_url=null; OB_STATE.birthday=''; OB_STATE.interests=[]; OB_STATE.follows=[];
  OB_STATE.joined_communities=[]; OB_STATE.permissions={notifications:false,find_friends:false};
  window._obPickTab = 'communities';
  show('screen-onboarding');
  obRender();
}

/* ================= CALLS ================= */
let pc = null, localStream = null, remoteStream = null, currentCall = null;
let callTimerInt = null, callStartedAt = null, isMuted = false, isCameraOff = false;
const RTC_CONFIG = { iceServers: [ { urls: 'stun:stun.l.google.com:19302' }, { urls: 'stun:stun1.l.google.com:19302' } ] };
function startCallTo(chatId, kind){
  const chat = chatId ? chatsCache.find(c => Number(c.id) === Number(chatId)) : currentChat;
  if (!chat || !chat.other_id){ if (typeof toast==='function') toast('Open a chat first'); return; }
  const callId = 'call_' + me.id + '_' + chat.other_id + '_' + Date.now();
  currentCall = { callId, kind, outgoing:true, otherId:Number(chat.other_id), otherName:displayName(chat), otherColor: chat.other_color || colorFor(displayName(chat)), otherUrl: chat.other_url || null };
  openCallOverlay('calling');
  if (socket) socket.emit('call:initiate', { to: chat.other_id, kind });
}
function startCall(kind){ startCallTo(null, kind); }
function openCallOverlay(state){
  const ov = document.getElementById('call-overlay'); if (!ov || !currentCall) return;
  const av = document.getElementById('call-avatar');
  av.textContent = currentCall.otherUrl ? '' : initials(currentCall.otherName);
  av.style.background = currentCall.otherUrl ? 'url('+currentCall.otherUrl+') center/cover' : (currentCall.otherColor || 'linear-gradient(135deg,#7b8cff,#b58cff)');
  document.getElementById('call-name').textContent = currentCall.otherName;
  document.getElementById('call-status').textContent = state || 'Connecting';
  document.getElementById('call-timer').textContent = '';
  document.getElementById('call-incoming-actions').style.display = 'none';
  document.getElementById('call-active-actions').style.display = 'none';
  document.getElementById('call-video-wrap').style.display = 'none';
  document.getElementById('call-bg').style.display = 'block';
  document.getElementById('btn-camera').style.display = currentCall.kind === 'video' ? 'flex' : 'none';
  ov.classList.add('show');
}
function setCallStatus(t){ const el = document.getElementById('call-status'); if (el) el.textContent = t; }
function incomingCallScreen(payload){
  const caller = chatsCache.find(c => Number(c.other_id) === Number(payload.from));
  currentCall = { callId:payload.callId, kind:payload.kind, outgoing:false, otherId:Number(payload.from),
    otherName: caller ? displayName(caller) : 'Unknown',
    otherColor: caller ? (caller.other_color || colorFor(displayName(caller))) : '#7b8cff',
    otherUrl: caller ? caller.other_url : null };
  openCallOverlay(payload.kind === 'video' ? 'Incoming video call' : 'Incoming call');
  document.getElementById('call-incoming-actions').style.display = 'flex';
  playRingtone();
  try { if (navigator.vibrate) navigator.vibrate([400,200,400,200,400]); } catch(_){}
}
async function setupMedia(kind){
  const c = kind === 'video' ? { audio:true, video:{ facingMode:'user' } } : { audio:true, video:false };
  localStream = await navigator.mediaDevices.getUserMedia(c);
  const lv = document.getElementById('call-local-video'); if (lv) lv.srcObject = localStream;
  return localStream;
}
async function createPeerConnection(){
  pc = new RTCPeerConnection(RTC_CONFIG);
  if (localStream) localStream.getTracks().forEach(t => pc.addTrack(t, localStream));
  remoteStream = new MediaStream();
  const rv = document.getElementById('call-remote-video'); if (rv) rv.srcObject = remoteStream;
  pc.ontrack = (ev) => {
    ev.streams[0].getTracks().forEach(t => { if (!remoteStream.getTracks().find(x => x.id === t.id)) remoteStream.addTrack(t); });
    if (currentCall && currentCall.kind === 'video'){
      document.getElementById('call-video-wrap').style.display = 'block';
      document.getElementById('call-bg').style.display = 'none';
    }
  };
  pc.onicecandidate = (ev) => {
    if (ev.candidate && socket && currentCall){
      socket.emit('call:signal', { callId: currentCall.callId, to: currentCall.otherId, payload: { type:'ice', candidate: ev.candidate } });
    }
  };
  pc.onconnectionstatechange = () => {
    if (!pc) return;
    if (pc.connectionState === 'connected'){ setCallStatus('Connected'); startCallTimer(); stopRingtone(); }
    else if (pc.connectionState === 'disconnected' || pc.connectionState === 'failed'){ setCallStatus('Call ended'); setTimeout(cleanupCall, 800); }
  };
  return pc;
}
async function acceptCall(){
  if (!currentCall) return;
  stopRingtone();
  document.getElementById('call-incoming-actions').style.display = 'none';
  document.getElementById('call-active-actions').style.display = 'flex';
  setCallStatus('Connecting');
  try {
    await setupMedia(currentCall.kind);
    await createPeerConnection();
    if (socket) socket.emit('call:accept', { callId: currentCall.callId });
  } catch(e){ alert('Could not access mic/camera: '+e.message); endCall('failed'); }
}
async function startOutgoingMedia(){
  document.getElementById('call-active-actions').style.display = 'flex';
  setCallStatus('Ringing');
  playRingtone();
  try { await setupMedia(currentCall.kind); await createPeerConnection(); }
  catch(e){ alert('Could not access mic/camera: '+e.message); endCall('failed'); }
}
async function handleCallSignal(payload){
  if (!pc) return;
  try {
    if (payload.type === 'offer'){
      await pc.setRemoteDescription(new RTCSessionDescription(payload.sdp));
      const answer = await pc.createAnswer();
      await pc.setLocalDescription(answer);
      socket.emit('call:signal', { callId: currentCall.callId, to: currentCall.otherId, payload: { type:'answer', sdp: answer } });
    } else if (payload.type === 'answer'){
      await pc.setRemoteDescription(new RTCSessionDescription(payload.sdp));
    } else if (payload.type === 'ice' && payload.candidate){
      await pc.addIceCandidate(new RTCIceCandidate(payload.candidate));
    }
  } catch(e){ console.warn('signal error', e); }
}
async function sendOffer(){
  if (!pc) return;
  try {
    const offer = await pc.createOffer();
    await pc.setLocalDescription(offer);
    socket.emit('call:signal', { callId: currentCall.callId, to: currentCall.otherId, payload: { type:'offer', sdp: offer } });
  } catch(e){ console.warn('offer error', e); }
}
function startCallTimer(){
  if (callTimerInt) return;
  callStartedAt = Date.now();
  callTimerInt = setInterval(() => {
    const s = Math.floor((Date.now()-callStartedAt)/1000);
    const el = document.getElementById('call-timer');
    if (el) el.textContent = String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0');
  }, 500);
}
function stopCallTimer(){ if (callTimerInt){ clearInterval(callTimerInt); callTimerInt=null; } }
function toggleMute(){
  if (!localStream) return;
  isMuted = !isMuted;
  localStream.getAudioTracks().forEach(t => t.enabled = !isMuted);
  document.getElementById('btn-mute').classList.toggle('on', isMuted);
}
function toggleCamera(){
  if (!localStream) return;
  isCameraOff = !isCameraOff;
  localStream.getVideoTracks().forEach(t => t.enabled = !isCameraOff);
  document.getElementById('btn-camera').classList.toggle('off', isCameraOff);
}
async function endCall(reason){
  if (!currentCall){ closeCallOverlay(); return; }
  if (socket) socket.emit('call:end', { callId: currentCall.callId });
  const dur = callStartedAt ? Math.floor((Date.now()-callStartedAt)/1000) : 0;
  const status = reason === 'rejected' ? 'rejected' : (callStartedAt ? 'answered' : 'missed');
  try { await api('/api/calls/log', { method:'POST', body: JSON.stringify({ callee_id: currentCall.otherId, kind: currentCall.kind, status, duration_sec: dur }) }); } catch(_){}
  cleanupCall();
}
function cleanupCall(){
  stopRingtone(); stopCallTimer();
  if (pc){ try { pc.close(); } catch(_){} pc = null; }
  if (localStream){ localStream.getTracks().forEach(t => t.stop()); localStream = null; }
  remoteStream = null; isMuted = false; isCameraOff = false; callStartedAt = null;
  const m = document.getElementById('btn-mute'); if (m) m.classList.remove('on');
  const c = document.getElementById('btn-camera'); if (c) c.classList.remove('off');
  closeCallOverlay();
  currentCall = null;
}
function closeCallOverlay(){ const ov = document.getElementById('call-overlay'); if (ov) ov.classList.remove('show'); }
let ringCtx = null, ringOsc = null, ringLoop = null;
function playRingtone(){
  try {
    stopRingtone();
    ringCtx = new (window.AudioContext || window.webkitAudioContext)();
    const beep = () => {
      if (!ringCtx) return;
      ringOsc = ringCtx.createOscillator();
      const g = ringCtx.createGain();
      ringOsc.type = 'sine'; ringOsc.frequency.value = 620; g.gain.value = 0.12;
      ringOsc.connect(g); g.connect(ringCtx.destination);
      ringOsc.start(); ringOsc.stop(ringCtx.currentTime + 0.4);
    };
    beep(); ringLoop = setInterval(beep, 1600);
  } catch(_){}
}
function stopRingtone(){
  if (ringLoop){ clearInterval(ringLoop); ringLoop = null; }
  if (ringOsc){ try { ringOsc.stop(); } catch(_){} ringOsc = null; }
  if (ringCtx){ try { ringCtx.close(); } catch(_){} ringCtx = null; }
}
async function openCallsTab(){
  show('screen-calls');
  const list = document.getElementById('calls-list');
  list.innerHTML = '<div class="call-empty">Loading...</div>';
  try {
    const rows = await api('/api/calls');
    if (!rows.length){ list.innerHTML = '<div class="call-empty">No calls yet.</div>'; return; }
    list.innerHTML = rows.map(c => {
      const color = c.other_color || colorFor(c.other_name);
      const missed = !c.outgoing && c.status !== 'answered';
      const arrow = c.outgoing ? 'out' : 'in';
      const dur = c.duration_sec ? Math.floor(c.duration_sec/60)+'m '+(c.duration_sec%60)+'s' : '';
      const avStyle = c.other_url ? 'background-image:url('+c.other_url+');background-size:cover;background-position:center' : 'background:'+color;
      return '<div class="call-item '+(missed?'missed':'')+'">'+
        '<div class="avatar" style="'+avStyle+'">'+(c.other_url?'':esc(initials(c.other_name)))+'</div>'+
        '<div class="info"><b>'+esc(c.other_name)+'</b><small>'+arrow+' '+(missed?'Missed':(c.outgoing?'Outgoing':'Incoming'))+' - '+esc(c.kind)+'</small></div>'+
        '<div class="call-item-actions">'+
          '<button class="call-back-btn" title="Audio call" onclick="event.stopPropagation();callBack('+c.other_id+',\'audio\')">'+
            '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 3.5h3l1.5 4-2 1.5a12 12 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.7a2 2 0 0 1 2-2.2z"/></svg>'+
          '</button>'+
          '<button class="call-back-btn" title="Video call" onclick="event.stopPropagation();callBack('+c.other_id+',\'video\')">'+
            '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="13" height="12" rx="2.5"/><path d="M16 10.5l5-2.5v8l-5-2.5"/></svg>'+
          '</button>'+
        '</div>'+
        '<div class="meta"><span class="time">'+timeAgo(c.started_at)+'</span>'+(dur?'<span class="dur">'+dur+'</span>':'')+'</div>'+
      '</div>';
    }).join('');
  } catch(e){ list.innerHTML = '<div class="call-empty">Could not load calls</div>'; }
}

/* ================= CALLS TAB HELPERS ================= */
function closeCallsTab(){
  show('screen-list');
  if (typeof loadChats === 'function') loadChats();
}

async function callBack(otherId, kind){
  // Find or create a DM chat with this user, then start the call
  try {
    const existing = (chatsCache || []).find(c => c.type === 'dm' && Number(c.other_id) === Number(otherId));
    if (existing){
      startCallTo(existing.id, kind);
      return;
    }
    // No existing chat — ask the user for the email (fallback)
    if (typeof toast === 'function') toast('Open a chat with this user first');
  } catch(e){ alert(e.message); }
}


function isDisappearingActive(){
  var d = (userPrefs && userPrefs.disappearing) || 'Off';
  return d && d !== 'Off';
}
function disappearingLabel(){
  var d = (userPrefs && userPrefs.disappearing) || 'Off';
  if (d === '24 hours') return '24h';
  if (d === '7 days') return '7d';
  if (d === '90 days') return '90d';
  return '';
}

function openDisappearPicker(){
  showPicker('Disappearing messages', ['Off','24 hours','7 days','90 days'], 'disappearing');
}

