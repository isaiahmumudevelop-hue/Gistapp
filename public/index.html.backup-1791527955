/* EDIT */
function editMsg(id){
  const m=messagesCache.find(x=>x.id===id);if(!m)return;
  document.getElementById('edit-text').value=m.body||'';
  document.getElementById('edit-text').dataset.id=id;
  openModal('edit-modal');
}
async function saveEdit(){
  const id=Number(document.getElementById('edit-text').dataset.id);
  const body=document.getElementById('edit-text').value.trim();
  try{await api('/api/messages/'+id+'/edit',{method:'PATCH',body:JSON.stringify({body})});closeModal('edit-modal');}catch(e){alert(e.message);}
