let userPrefs = {};


function renderSettingsSections(){
  const rightOf = r => {
    if (r.toggle !== undefined){
      const v = userPrefs[r.key] !== undefined ? userPrefs[r.key] : r.toggle;
      return '<button type="button" class="sw' + (v ? ' on' : '') + '" data-sw="' + r.key + '" role="switch" aria-checked="' + (!!v) + '" onclick="event.stopPropagation();togglePref(\'' + r.key + '\')"></button>';
    }
    if (r.options){
      const v = userPrefs[r.key] || r.options[0];
      return '<span class="val">' + esc(v) + '</span><span class="chev">' + setSvg('chev',2) + '</span>';
    }
    if (r.badge) return '<span class="badge">' + esc(r.badge) + '</span><span class="chev">' + setSvg('chev',2) + '</span>';
    if (r.value) return '<span class="val">' + esc(r.value) + '</span><span class="chev">' + setSvg('chev',2) + '</span>';
    return '<span class="chev">' + setSvg('chev',2) + '</span>';
  };
  document.getElementById('set-sections').innerHTML = SETTINGS_SECTIONS.map(sec =>
    '<div class="sgroup">' +
      '<div class="sgroup-label">' + esc(sec.title) + '</div>' +
      sec.rows.map(r =>
        '<button class="srow' + (r.danger?' danger':'') + '" data-key="' + (r.key||'') + '">' +
          '<span class="icw">' + setSvg(r.icon) + '</span>' +
          '<span class="rt"><span class="lbl">' + esc(r.label) + '</span>' + (r.sub ? '<span class="sub">' + esc(r.sub) + '</span>' : '') + '</span>' +
          rightOf(r) +
        '</button>').join('') +
    '</div>').join('');

  // row click → handleSettingClick (except when clicking the switch directly)
  document.querySelectorAll('#set-sections .srow').forEach(btn => {
    btn.addEventListener('click', (e) => {
      if (e.target.classList.contains('sw')) return; // switch handles itself
      handleSettingClick(btn.dataset.key);
    });
  });
}

function togglePref(key){
  const row = findRow(key);
  const current = userPrefs[key] !== undefined ? userPrefs[key] : (row && row.toggle);
  const next = !current;
  userPrefs[key] = next;

  // Instant visual update — no re-render
  document.querySelectorAll('[data-sw="' + key + '"]').forEach(el => {
    el.classList.toggle('on', next);
    el.setAttribute('aria-checked', next);
  });

  if (row && typeof toast === 'function') toast(row.label + ' turned ' + (next ? 'on' : 'off'));

  // Save to backend
  api('/api/me', { method:'PATCH', body: JSON.stringify({ prefs: { [key]: next } }) })
    .then(updated => { if (updated && updated.prefs) userPrefs = updated.prefs; })
    .catch(e => console.warn('save pref failed', e));
}

function findRow(key){
  for (const sec of SETTINGS_SECTIONS) for (const r of sec.rows) if (r.key === key) return r;
  return null;
}

async function savePref(key, value){
  userPrefs[key] = value;
  try {
    const updated = await api('/api/me', { method:'PATCH', body: JSON.stringify({ prefs: { [key]: value } }) });
    if (updated.prefs) userPrefs = updated.prefs;
  } catch(e){ console.warn('save pref failed', e); }
}

