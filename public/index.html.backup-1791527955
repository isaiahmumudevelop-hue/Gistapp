<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#8b8fd6">
<title>Chat — Email Messenger</title>
<script src="https://accounts.google.com/gsi/client" async defer></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --grad-1:linear-gradient(135deg,#7b8cff,#b58cff);
  --online:#30d158;--badge:#ffd60a;--ink:#1c1c22;--sub:#8e8e96;
  --bg:#fff;--bg-2:#f4f2fb;--bg-3:#faf9fd;--line:#f0edf5;
  --fs:15px;
  --safe-t:env(safe-area-inset-top,0px);--safe-b:env(safe-area-inset-bottom,0px);
}
body.dark{--ink:#f2f0fa;--sub:#9a97a8;--bg:#15141a;--bg-2:#1d1c26;--bg-3:#232230;--line:#2a2936}
*{margin:0;padding:0;box-sizing:border-box;font-family:'Inter',-apple-system,sans-serif;-webkit-tap-highlight-color:transparent}
html,body{height:100%;overflow:hidden;background:var(--bg);color:var(--ink);transition:background .2s,color .2s}
.app{position:fixed;inset:0;overflow:hidden;background:var(--bg)}
.screen{position:absolute;inset:0;display:flex;flex-direction:column;transform:translateX(102%);transition:transform .45s cubic-bezier(.32,.72,.22,1);background:var(--bg);z-index:10}
.screen.active{transform:translateX(0)}
.screen.behind{transform:translateX(-18%);filter:brightness(.75)}
.avatar{border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;flex-shrink:0;user-select:none}
.dot{position:absolute;right:1px;bottom:1px;width:13px;height:13px;border-radius:50%;background:var(--online);border:2.5px solid var(--bg)}
.icon-btn{width:38px;height:38px;border-radius:50%;border:none;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;background:transparent;color:var(--ink);transition:transform .15s}
.icon-btn:active{transform:scale(.9)}

/* AUTH */
#screen-auth{background:linear-gradient(160deg,#8b8fd6 0%,#b3a9dd 55%,#f4f1ff 100%);align-items:center;justify-content:center;padding:24px;z-index:30}
.auth-card{width:100%;max-width:420px;background:#fff;border-radius:28px;padding:30px 24px;box-shadow:0 30px 70px rgba(30,25,60,.25);color:#1c1c22}
.auth-card h1{font-size:26px;font-weight:800;margin-bottom:6px;letter-spacing:-.4px}
.auth-card p{font-size:13.5px;color:#8e8e96;margin-bottom:20px;line-height:1.5}
.auth-card input{width:100%;height:52px;border-radius:16px;border:1.5px solid #e8e5f0;background:#faf9fd;padding:0 16px;font-size:15px;color:#1c1c22;outline:none;margin-bottom:12px;transition:.15s}
.auth-card input:focus{border-color:#8b8fd6;background:#fff}
.auth-card .auth-btn{width:100%;height:52px;background:#14141a;color:#fff;border:none;border-radius:16px;font-size:15px;font-weight:700;cursor:pointer;margin-top:6px}
.auth-swap{text-align:center;font-size:13.5px;color:#8e8e96;margin-top:16px}
.auth-swap a{color:#6a62b8;font-weight:700;cursor:pointer;text-decoration:none}
.err{color:#e5484d;font-size:12.5px;font-weight:600;margin-bottom:8px;min-height:16px}

/* LIST */
#screen-list{background:var(--bg)}
.list-top{background:linear-gradient(180deg,#8b8fd6 0%,#b3a9dd 62%,var(--bg) 100%);padding:calc(20px + var(--safe-t)) 20px 4px}
body.dark .list-top{background:linear-gradient(180deg,#3a3d6b 0%,#252548 62%,var(--bg) 100%)}
.list-top .search-row{display:flex;align-items:center;gap:10px}
.search-pill{flex:1;height:40px;border-radius:20px;background:rgba(255,255,255,.38);backdrop-filter:blur(8px);display:flex;align-items:center;gap:8px;padding:0 14px;color:#fff;font-size:14px}
.search-pill input{background:none;border:none;outline:none;color:#fff;font-size:14px;width:100%}
.search-pill input::placeholder{color:rgba(255,255,255,.85)}
.list-title{color:#fff;font-size:29px;font-weight:800;line-height:1.15;margin:16px 0 6px;letter-spacing:-.5px}
.stories{display:flex;gap:15px;overflow-x:auto;padding:12px 20px 14px;scrollbar-width:none;flex-shrink:0}
.stories::-webkit-scrollbar{display:none}
.story{display:flex;flex-direction:column;align-items:center;gap:6px;flex-shrink:0;cursor:pointer}
.story .ring{width:62px;height:62px;border-radius:50%;padding:2.5px;background:var(--grad-1)}
.story .ring>div{width:100%;height:100%;border-radius:50%;border:2.5px solid var(--bg);display:flex;align-items:center;justify-content:center;font-weight:700;color:#fff;font-size:16px}
.story.add .ring{background:none;border:2px dashed #c9c3ee}
.story.add .ring>div{border:none;color:#9a92d8;font-size:26px;font-weight:500}
.story span{font-size:11.5px;color:var(--sub);font-weight:500;max-width:64px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:center}
.chats-head{display:flex;justify-content:space-between;align-items:center;padding:8px 20px 4px;flex-shrink:0}
.chats-head h2{font-size:21px;font-weight:800;color:var(--ink)}
.filters{display:flex;gap:8px;overflow-x:auto;padding:8px 16px 6px;scrollbar-width:none;flex-shrink:0}
.filters::-webkit-scrollbar{display:none}
.chip{padding:8px 14px;border-radius:20px;background:var(--bg-2);color:var(--sub);font-size:12.5px;font-weight:700;border:none;cursor:pointer;white-space:nowrap;transition:.15s}
.chip.on{background:#14141a;color:#fff}
body.dark .chip.on{background:#7b8cff}
.requests-wrap{padding:4px 16px 8px;flex-shrink:0}
.requests-wrap:empty{display:none}
.req-card{background:var(--bg-2);border-radius:18px;padding:12px 14px;margin:8px 0;display:flex;gap:12px;align-items:center;border:1px solid var(--line)}
.req-card .avatar{width:44px;height:44px;font-size:14px}
.req-card .info{flex:1;min-width:0}
.req-card .info b{font-size:14px;color:var(--ink);display:block}
.req-card .info small{font-size:12px;color:var(--sub);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block;margin-top:2px}
.req-card .acts{display:flex;gap:6px;flex-shrink:0}
.req-card button{border:none;border-radius:12px;padding:9px 13px;font-size:12.5px;font-weight:700;cursor:pointer}
.req-card .accept{background:#14141a;color:#fff}
body.dark .req-card .accept{background:#7b8cff}
.req-card .decline{background:var(--bg-3);color:var(--sub)}
.chat-scroll{flex:1;overflow-y:auto;padding-bottom:calc(120px + var(--safe-b));scrollbar-width:none}
.chat-scroll::-webkit-scrollbar{display:none}
.chat-item{display:flex;align-items:center;gap:13px;padding:11px 20px;cursor:pointer;position:relative;transition:background .15s}
.chat-item:hover{background:var(--bg-2)}
.chat-item .ava-wrap{position:relative;width:54px;height:54px;flex-shrink:0}
.chat-item .ava-wrap .avatar{width:54px;height:54px;font-size:17px}
.chat-meta{flex:1;min-width:0}
.chat-meta .name{font-size:15.5px;font-weight:700;color:var(--ink);display:flex;align-items:center;gap:6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chat-meta .preview{font-size:13px;color:var(--sub);margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chat-side{display:flex;flex-direction:column;align-items:flex-end;gap:5px;flex-shrink:0}
.chat-side time{font-size:11.5px;color:#b9b6c2;font-weight:500;white-space:nowrap}
.unread{min-width:20px;height:20px;border-radius:11px;background:var(--badge);color:#5c4d00;font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center;padding:0 6px}
.waiting-tag{font-size:10px;font-weight:700;background:#ffe6a3;color:#7a5a00;padding:2px 7px;border-radius:10px}
.group-tag{font-size:10px;font-weight:700;background:var(--bg-3);color:var(--sub);padding:2px 7px;border-radius:10px}
.mini-icon{font-size:11px;opacity:.6}
.empty{padding:46px 20px;text-align:center;color:var(--sub);font-size:14px;line-height:1.6}
.bottom-nav{position:absolute;left:0;right:0;bottom:0;height:calc(78px + var(--safe-b));padding:0 26px var(--safe-b);background:var(--bg);border-top:1px solid var(--line);display:flex;align-items:center;justify-content:space-around;z-index:20}
.nav-ic{width:44px;height:44px;border-radius:14px;display:flex;align-items:center;justify-content:center;color:#b7b3c2;cursor:pointer}
.nav-ic.on{color:var(--ink)}
.new-chat-btn{background:#14141a;color:#fff;border:none;border-radius:24px;padding:15px 24px;font-size:14px;font-weight:700;display:flex;align-items:center;gap:8px;cursor:pointer;box-shadow:0 10px 24px rgba(20,20,26,.35)}
body.dark .new-chat-btn{background:#7b8cff}

/* DM */
#screen-dm{background:linear-gradient(180deg,#9fa2dd 0%,#c8bce6 58%,#b6b1de 100%)}
body.dark #screen-dm{background:linear-gradient(180deg,#1f1e33 0%,#15141f 58%,#0f0e17 100%)}
.dm-header{display:flex;align-items:center;gap:12px;padding:calc(16px + var(--safe-t)) 16px 12px;color:#fff;flex-shrink:0}
body.dark .dm-header{color:var(--ink)}
.dm-header .avatar{width:44px;height:44px;font-size:16px;border:2px solid rgba(255,255,255,.7)}
.dm-header .who{min-width:0;flex:1;cursor:pointer}
.dm-header .who b{font-size:19px;font-weight:800;display:block;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.dm-header .who small{font-size:11.5px;opacity:.92;display:flex;align-items:center;gap:5px;margin-top:2px}
.dm-header .spacer{flex:1}
.dm-header .icon-btn{background:rgba(30,32,58,.55);color:#fff}
.dm-body{flex:1;overflow-y:auto;padding:8px 16px 12px;display:flex;flex-direction:column;gap:8px;scrollbar-width:none}
.dm-body::-webkit-scrollbar{display:none}
#dm-messages{display:flex;flex-direction:column;gap:8px}
.time-chip{align-self:center;font-size:10.5px;font-weight:600;color:#5f5b80;background:rgba(255,255,255,.5);border-radius:12px;padding:4px 11px;margin:6px 0}
body.dark .time-chip{color:#b9b6c2;background:rgba(255,255,255,.08)}
.bubble{max-width:80%;padding:10px 14px;font-size:var(--fs);line-height:1.45;position:relative;animation:pop .3s cubic-bezier(.3,1.4,.5,1);word-wrap:break-word;overflow-wrap:anywhere}
@keyframes pop{from{opacity:0;transform:translateY(8px) scale(.96)}to{opacity:1;transform:none}}
.bubble.in{align-self:flex-start;background:rgba(255,255,255,.78);color:#2e2c3d;border-radius:19px 19px 19px 6px;box-shadow:0 4px 14px rgba(70,60,120,.12)}
.bubble.out{align-self:flex-end;background:#33344c;color:#fff;border-radius:19px 19px 6px 19px}
body.dark .bubble.in{background:#232230;color:#e8e6f3}
body.dark .bubble.out{background:#4a55b8}
.bubble .t{display:block;font-size:10px;opacity:.55;margin-top:4px;text-align:right;font-weight:600}
.bubble .receipt{display:inline-block;margin-left:5px;font-size:11px;opacity:.8}
.bubble.media{padding:6px}
.bubble.media img,.bubble.media video{max-width:100%;max-height:320px;border-radius:14px;display:block;cursor:pointer}
.bubble.media audio{max-width:240px}
.bubble.media .caption{padding:6px 8px 0}
.bubble.deleted{opacity:.5;font-style:italic}
.bubble.pinned{outline:2px solid #ffd60a}
.bubble .star-mark{color:#ffd60a;font-size:11px;margin-right:4px}
.bubble .reply-quote{background:rgba(0,0,0,.08);border-left:3px solid #7b8cff;padding:6px 10px;border-radius:8px;margin-bottom:6px;font-size:12.5px;opacity:.85}
body.dark .bubble .reply-quote{background:rgba(255,255,255,.08)}
.reacts{display:flex;gap:3px;margin-top:6px;flex-wrap:wrap}
.reacts span{background:rgba(255,255,255,.75);border-radius:10px;padding:1px 7px;font-size:12px;color:#2e2c3d;font-weight:600}
body.dark .reacts span{background:#1a1924;color:#f2f0fa}
.bubble .react-toggle{position:absolute;top:-10px;right:-6px;background:var(--bg);color:var(--sub);border:1px solid var(--line);border-radius:50%;width:26px;height:26px;display:none;align-items:center;justify-content:center;font-size:13px;cursor:pointer}
.bubble:hover .react-toggle{display:flex}
.reply-bar{display:none;margin:0 14px;padding:10px 14px;background:rgba(255,255,255,.7);border-radius:16px;border-left:4px solid #7b8cff;font-size:13px;color:#2e2c3d;position:relative}
body.dark .reply-bar{background:#232230;color:#f2f0fa}
.reply-bar.show{display:block}
.reply-bar b{display:block;font-size:11.5px;color:#7b8cff;margin-bottom:2px}
.reply-bar .close{position:absolute;right:10px;top:8px;background:transparent;border:none;color:var(--sub);font-size:16px;cursor:pointer}
.dm-input{margin:6px 14px calc(14px + var(--safe-b));display:flex;align-items:center;gap:8px;background:rgba(255,255,255,.55);border-radius:27px;padding:7px 7px 7px 16px;backdrop-filter:blur(6px);flex-shrink:0}
body.dark .dm-input{background:#1c1b26}
.dm-input input{flex:1;background:none;border:none;outline:none;font-size:14px;color:#2e2c3d;min-width:0}
body.dark .dm-input input{color:#f2f0fa}
.dm-input input::placeholder{color:#6f6a92}
.dm-input .attach{width:38px;height:38px;border-radius:50%;background:transparent;border:none;color:#23242f;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0}
body.dark .dm-input .attach{color:#c9c5dd}
.send-dark{width:42px;height:42px;border-radius:50%;background:#23242f;border:none;color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0}
body.dark .send-dark{background:#7b8cff}
.waiting-bar{margin:6px 14px calc(14px + var(--safe-b));padding:14px;border-radius:22px;background:rgba(255,255,255,.72);text-align:center;font-size:13.5px;color:#4a4568;font-weight:600;flex-shrink:0}
body.dark .waiting-bar{background:#232230;color:#c9c5dd}
.typing-pill{align-self:center;display:none;align-items:center;gap:8px;background:#a7e56e;color:#20330f;font-size:12.5px;font-weight:600;border-radius:16px;padding:6px 13px 6px 6px;flex-shrink:0}
.typing-pill.show{display:flex}
.typing-pill .avatar{width:24px;height:24px;font-size:9px}
.typing-pill .dots{display:inline-flex;gap:2px;margin-left:2px}
.typing-pill .dots i{width:4px;height:4px;border-radius:50%;background:#3c5a17;animation:blink 1s infinite}
.typing-pill .dots i:nth-child(2){animation-delay:.2s}
.typing-pill .dots i:nth-child(3){animation-delay:.4s}
@keyframes blink{0%,100%{opacity:.25}50%{opacity:1}}

/* MENTIONS */
.mention-pop{position:absolute;background:var(--bg);border-radius:14px;box-shadow:0 12px 30px rgba(0,0,0,.25);padding:6px;z-index:120;max-height:220px;overflow-y:auto;min-width:220px}
.mention-pop button{display:block;width:100%;text-align:left;background:none;border:none;padding:10px 14px;border-radius:10px;font-size:14px;color:var(--ink);cursor:pointer;font-weight:600}
.mention-pop button:hover{background:var(--bg-2)}
.mention-pop small{display:block;font-size:11.5px;color:var(--sub);font-weight:500;margin-top:2px}

/* POPUP */
.popmenu{position:absolute;background:var(--bg);border-radius:16px;box-shadow:0 16px 40px rgba(0,0,0,.25);padding:6px;display:none;z-index:100;min-width:180px}
.popmenu.show{display:block}
.popmenu button{display:flex;align-items:center;gap:10px;width:100%;background:none;border:none;padding:11px 14px;border-radius:12px;font-size:14px;font-weight:600;color:var(--ink);cursor:pointer;text-align:left}
.popmenu button:hover{background:var(--bg-2)}
.emoji-row{display:flex;gap:4px;padding:6px}
.emoji-row button{width:36px;height:36px;padding:0;border-radius:50%;font-size:18px;justify-content:center}

/* SHEET */
.backdrop{position:absolute;inset:0;background:rgba(20,18,30,.45);opacity:0;pointer-events:none;transition:opacity .3s;z-index:70}
.backdrop.show{opacity:1;pointer-events:auto}
.sheet{position:absolute;left:10px;right:10px;bottom:calc(10px + var(--safe-b));background:var(--bg);border-radius:28px;padding:12px 12px 16px;transform:translateY(calc(115% + var(--safe-b)));transition:transform .42s cubic-bezier(.32,.72,.22,1);z-index:80}
.sheet.show{transform:translateY(0)}
.sheet .grab{width:42px;height:5px;border-radius:3px;background:var(--line);margin:4px auto 12px}
.sheet-opt{display:flex;gap:14px;align-items:center;padding:13px 14px;border-radius:18px;cursor:pointer}
.sheet-opt:hover{background:var(--bg-2)}
.sheet-opt .ic{width:44px;height:44px;border-radius:50%;background:var(--bg-2);color:#6a62b8;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.sheet-opt b{font-size:15px;color:var(--ink);display:block}
.sheet-opt small{font-size:12px;color:var(--sub)}
.cancel-btn{margin-top:12px;width:100%;padding:15px;border:none;border-radius:22px;background:var(--bg-2);font-size:15px;font-weight:700;color:var(--ink);cursor:pointer}

/* MODAL */
.modal-wrap{position:absolute;inset:0;background:rgba(18,16,28,.55);backdrop-filter:blur(3px);display:none;align-items:center;justify-content:center;padding:22px;z-index:95}
.modal-wrap.show{display:flex}
.modal{width:100%;max-width:420px;background:var(--bg);border-radius:26px;padding:24px;max-height:85vh;overflow-y:auto;animation:pop .28s}
.modal h3{font-size:20px;font-weight:800;color:var(--ink);margin-bottom:6px}
.modal p{font-size:13.5px;color:var(--sub);line-height:1.5;margin-bottom:16px}
.modal input,.modal textarea{width:100%;height:52px;border-radius:16px;border:1.5px solid var(--line);background:var(--bg-3);padding:0 16px;font-size:15px;color:var(--ink);outline:none;font-family:inherit}
.modal textarea{height:auto;min-height:60px;padding:14px 16px;resize:vertical}
.modal input:focus,.modal textarea:focus{border-color:#8b8fd6}
.modal .err{font-size:12.5px;color:#e5484d;margin-top:8px;min-height:16px;font-weight:600}
.modal-actions{display:flex;gap:10px;margin-top:12px}
.modal-actions button{flex:1;height:50px;border-radius:16px;border:none;font-size:15px;font-weight:700;cursor:pointer}
.modal-actions .ghost{background:var(--bg-2);color:var(--ink)}
.modal-actions .primary{background:#14141a;color:#fff}
body.dark .modal-actions .primary{background:#7b8cff}
.swatch-row{display:flex;gap:8px;margin:8px 0 14px;flex-wrap:wrap}
.swatch{width:38px;height:38px;border-radius:50%;cursor:pointer;border:3px solid transparent}
.swatch.on{border-color:var(--ink)}
.toggle-row{display:flex;justify-content:space-between;align-items:center;padding:14px 0;border-bottom:1px solid var(--line);font-size:15px;font-weight:600}
.toggle{width:48px;height:28px;border-radius:14px;background:var(--line);position:relative;cursor:pointer;transition:.2s}
.toggle.on{background:#7b8cff}
.toggle::after{content:'';position:absolute;top:3px;left:3px;width:22px;height:22px;border-radius:50%;background:#fff;transition:.2s}
.toggle.on::after{transform:translateX(20px)}
.slider-row{padding:14px 0;border-bottom:1px solid var(--line)}
.slider-row label{font-size:13px;color:var(--sub);font-weight:600;display:block;margin-bottom:8px}
.slider-row input[type=range]{width:100%}

/* MEDIA GALLERY */
.media-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:4px;margin-top:12px}
.media-grid .tile{aspect-ratio:1;background:var(--bg-3);border-radius:8px;overflow:hidden;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--sub);font-size:11px}
.media-grid .tile img,.media-grid .tile video{width:100%;height:100%;object-fit:cover}

/* LIGHTBOX */
.lightbox{position:absolute;inset:0;background:rgba(0,0,0,.92);display:none;align-items:center;justify-content:center;z-index:200;padding:20px}
.lightbox.show{display:flex}
.lightbox img,.lightbox video{max-width:100%;max-height:100%;border-radius:12px}
.lightbox .close-lb{position:absolute;top:calc(20px + var(--safe-t));right:20px;background:rgba(255,255,255,.15);border:none;color:#fff;border-radius:50%;width:44px;height:44px;font-size:22px;cursor:pointer}

@media (min-width:820px){
  .list-top,.stories,.chats-head,.filters,.requests-wrap,.chat-scroll,.dm-header,.dm-body,.dm-input,.waiting-bar{max-width:900px;margin-left:auto;margin-right:auto;width:100%}
  .bottom-nav{max-width:900px;left:50%;right:auto;transform:translateX(-50%);width:100%}
}

/* E2E footer */
.e2e-footer{position:absolute;left:0;right:0;bottom:calc(78px + var(--safe-b));text-align:center;font-size:11px;color:var(--sub);padding:10px 20px 12px;background:linear-gradient(180deg,transparent,var(--bg) 45%);font-weight:500;z-index:15;pointer-events:none}

/* SETTINGS SCREEN */
#screen-settings{background:var(--bg)}
.set-head{
  background:var(--bg);
  padding:calc(14px + var(--safe-t)) 16px 12px;
  display:flex;align-items:center;justify-content:space-between;
  flex-shrink:0;position:relative;
}
.hd-btn{
