async function uploadAndSave(file, field){
  if (!file) return;
  if (!file.type.startsWith('image/')){ if (typeof toast==='function') toast('Pick an image file'); return; }
  if (file.size > 5 * 1024 * 1024){ if (typeof toast==='function') toast('Image too big (max 5MB)'); return; }
  if (typeof toast==='function') toast('Uploading…');
  const fd = new FormData();
  fd.append('file', file);
  try {
    const res = await fetch('/api/upload', {
      method: 'POST',
      headers: { Authorization: 'Bearer ' + token },
      body: fd
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Upload failed');
    const patch = {};
    patch[field] = data.url;
    const updated = await api('/api/me', { method:'PATCH', body: JSON.stringify(patch) });
    me = Object.assign({}, me, updated);
    if (typeof toast==='function') toast(field === 'cover_url' ? 'Cover updated' : 'Photo updated');
    applyProfileImages();
  } catch(e){ alert(e.message); }
}

function applyProfileImages(){
  if (!me) return;
  const av = document.getElementById('pf-avatar');
  const cover = document.getElementById('pf-cover');
  if (me.avatar_url){
    av.style.backgroundImage = 'url(' + me.avatar_url + ')';
    av.style.backgroundSize = 'cover';
    av.style.backgroundPosition = 'center';
    av.textContent = '';
  } else {
    av.style.backgroundImage = '';
    av.textContent = (me.display_name || '?').split(/\s+/).map(w=>w[0]).join('').slice(0,2).toUpperCase();
