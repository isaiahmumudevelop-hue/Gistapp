function handleSettingClick(key){
  if (!key) return;
  const row = findRow(key);
  if (!row) return;

  if (row.soon){ showSoon(row.label); return; }

  if (row.options){ showPicker(row.label, row.options, key); return; }

  switch(key){
    case 'blocked_list':   openBlockedList(); break;
    case 'chat_history':   openChatHistory(); break;
    case 'advanced':       openAdvanced(); break;
    case 'privacy_checkup':openPrivacyCheckup(); break;
    case 'delete_account': deleteAccount(); break;
    case 'change_email':   openChangeEmail(); break;
    case 'two_factor':     open2FA(); break;
    case 'tones':          showSoon('Custom tones'); break;
    case 'avatar':         showSoon('Avatar editor'); break;
    case 'help':           window.location.href = 'mailto:support@gistapp.app?subject=GistApp%20Support'; break;
    case 'network_usage':  showInfo('Network usage', 'Approximately 2.4 GB downloaded this month.'); break;
    case 'manage_storage': showInfo('Storage', 'Media cache uses about 6.8 GB. Clear from Chat history.'); break;
    default:
      if (row.toggle) togglePref(key);
      else if (typeof toast==='function') toast(row.label);
  }
}

