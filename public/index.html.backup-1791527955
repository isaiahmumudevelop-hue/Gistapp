  try {
    await api('/api/2fa/disable', { method:'POST', body: JSON.stringify({ password }) });
    me.totp_enabled = false;
    closePicker();
    if (typeof toast === 'function') toast('Two-step verification turned off');
  } catch(e){ alert(e.message); }
}

