/* SEND */
document.getElementById('dm-text').addEventListener('input',e=>{
  if(!socket||!currentChat)return;
  socket.emit('typing',{chatId:currentChat.id,typing:true});
  clearTimeout(typingTimer);
  typingTimer=setTimeout(()=>socket.emit('typing',{chatId:currentChat.id,typing:false}),1200);
  handleMentions(e.target.value);
});
document.getElementById('dm-form').addEventListener('submit',async e=>{
  e.preventDefault();
  if(!currentChat)return;
  const inp=document.getElementById('dm-text');
  const body=inp.value.trim();
  if(!body)return;
  const now=Date.now();
  if(lastSend.body===body&&(now-lastSend.t)<1500)return;
  lastSend={body,t:now};
  inp.value='';
  document.getElementById('mention-pop').style.display='none';
  try{
    const payload={body};
    if(replyTo)payload.reply_to_id=replyTo;
    const m=await api('/api/chats/'+currentChat.id+'/messages',{method:'POST',body:JSON.stringify(payload)});
    const msgs=document.getElementById('dm-messages');
    if(!msgs.querySelector('.bubble[data-id="'+m.id+'"]'))appendBubble(m,false);
    messagesCache.push(m);
    cancelReply();
    loadChats();
  }catch(e){alert(e.message);}
});
function pickFile(){document.getElementById('file-pick').click();}
document.getElementById('file-pick').addEventListener('change',async e=>{
  const f=e.target.files[0];if(!f||!currentChat)return;
  const fd=new FormData();fd.append('file',f);
  try{
    const res=await fetch('/api/upload',{method:'POST',headers:{Authorization:'Bearer '+token},body:fd});
    const data=await res.json();
    if(!res.ok)throw new Error(data.error||'Upload failed');
    const m=await api('/api/chats/'+currentChat.id+'/messages',{method:'POST',body:JSON.stringify({body:'',media_url:data.url,media_type:data.type})});
    const msgs=document.getElementById('dm-messages');
    if(!msgs.querySelector('.bubble[data-id="'+m.id+'"]'))appendBubble(m,false);
    messagesCache.push(m);
    loadChats();
  }catch(err){alert(err.message);}
  e.target.value='';
});

/* MENTIONS */
function handleMentions(val){
  if(!currentChat||currentChat.type!=='group')return;
  const m=val.match(/@(\w*)$/);
  const pop=document.getElementById('mention-pop');
  if(!m){pop.style.display='none';return;}
  const q=m[1].toLowerCase();
  const matches=(currentChat.members||[]).filter(x=>x.display_name.toLowerCase().startsWith(q)).slice(0,5);
  if(!matches.length){pop.style.display='none';return;}
  pop.innerHTML=matches.map(u=>`<button onclick="insertMention('${esc(u.display_name)}')">@${esc(u.display_name)}<small>${esc(u.email||'')}</small></button>`).join('');
  pop.style.display='block';
  pop.style.left='16px';
  pop.style.bottom=(window.innerHeight/2)+'px';
}
function insertMention(name){
  const inp=document.getElementById('dm-text');
  inp.value=inp.value.replace(/@\w*$/,'@'+name+' ');
  document.getElementById('mention-pop').style.display='none';
  inp.focus();
}

